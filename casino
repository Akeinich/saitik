<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Казино «Удача»</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600;700&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#c9a227;--gold-l:#f0d060;--gold-d:#7a5a0a;
  --bg:#06090f;--bg2:#0c1220;--bg3:#101828;
  --felt:#081f14;--felt2:#0a2a1a;
  --neon:#00ffaa;--neon2:#ff2266;--neon3:#ffcc00;
  --text:#e8d5a0;--text2:#a08858;--text3:#5a4030;
  --win:#00ffaa;--lose:#ff2266;
  --card:#0d1e30;--border:#c9a22740;
  --cell:90px;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Cinzel',serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;cursor:default;}
canvas#bg{position:fixed;inset:0;z-index:0;pointer-events:none;}

/* ── SCREENS ── */
.screen{display:none;position:relative;z-index:1;min-height:100vh;flex-direction:column;align-items:center;padding:0 1rem 3rem;}
.screen.active{display:flex;}

/* ── LOBBY ── */
#lobby{padding-top:3rem;}
.lobby-title{font-family:'Cinzel Decorative',serif;font-size:clamp(2rem,6vw,4.5rem);font-weight:900;color:var(--gold);text-align:center;letter-spacing:.04em;text-shadow:0 0 40px #c9a22780,0 0 80px #c9a22740;line-height:1.1;margin-bottom:.5rem;}
.lobby-sub{font-size:.85rem;letter-spacing:.25em;color:var(--text2);text-align:center;text-transform:uppercase;margin-bottom:2.5rem;}
.balance-bar{display:flex;align-items:center;gap:.75rem;background:var(--bg3);border:1px solid var(--border);border-radius:50px;padding:.6rem 1.5rem;font-size:1.1rem;font-weight:700;color:var(--gold);margin-bottom:3rem;box-shadow:0 0 30px #c9a22720;position:relative;}
.balance-bar::before{content:'◆';margin-right:.25rem;color:var(--gold-l);}
.balance-coins{font-family:'Cinzel Decorative',serif;font-size:1.3rem;letter-spacing:.05em;}
.balance-label{font-size:.7rem;letter-spacing:.2em;color:var(--text2);text-transform:uppercase;}
.deco-line{width:min(400px,80vw);height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:.5rem auto 2rem;}
.deco-line-sm{width:80px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:.3rem auto;}

/* ── GAME CARDS ── */
.game-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;max-width:900px;width:100%;}
.game-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:2rem 1.5rem;cursor:pointer;transition:transform .2s,box-shadow .2s,border-color .2s;position:relative;overflow:hidden;text-align:center;}
.game-card::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,#c9a22712 0%,transparent 60%);pointer-events:none;}
.game-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px #c9a22730;border-color:var(--gold);}
.game-card-icon{font-size:3rem;margin-bottom:1rem;display:block;filter:drop-shadow(0 0 12px #c9a22760);}
.game-card-title{font-family:'Cinzel Decorative',serif;font-size:1.1rem;color:var(--gold);margin-bottom:.5rem;}
.game-card-desc{font-size:.75rem;color:var(--text2);letter-spacing:.05em;line-height:1.6;}
.game-card-badge{position:absolute;top:.75rem;right:.75rem;font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;background:var(--gold);color:var(--bg);padding:.2rem .5rem;border-radius:4px;font-weight:700;}

/* ── BACK BUTTON + HEADER ── */
.game-header{width:100%;max-width:900px;display:flex;align-items:center;justify-content:space-between;padding:1.5rem 0 1rem;}
.back-btn{background:none;border:1px solid var(--border);color:var(--text2);padding:.4rem 1rem;border-radius:8px;cursor:pointer;font-family:'Cinzel',serif;font-size:.75rem;letter-spacing:.1em;transition:all .2s;}
.back-btn:hover{border-color:var(--gold);color:var(--gold);}
.game-title{font-family:'Cinzel Decorative',serif;font-size:1.4rem;color:var(--gold);letter-spacing:.05em;}
.hdr-balance{font-size:.85rem;color:var(--text2);}
.hdr-balance span{color:var(--gold);font-weight:700;}

/* ── BET INPUT ── */
.bet-area{display:flex;align-items:center;gap:.75rem;margin:1.5rem 0;flex-wrap:wrap;justify-content:center;}
.bet-label{font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text2);}
.bet-input{background:var(--bg3);border:1px solid var(--border);color:var(--gold);font-family:'Cinzel',serif;font-size:1.1rem;padding:.5rem .9rem;border-radius:8px;width:110px;text-align:center;outline:none;transition:border-color .2s;}
.bet-input:focus{border-color:var(--gold);}
.bet-chips{display:flex;gap:.5rem;}
.chip{background:transparent;border:1px solid var(--border);color:var(--text2);padding:.3rem .7rem;border-radius:6px;cursor:pointer;font-family:'Cinzel',serif;font-size:.75rem;transition:all .15s;}
.chip:hover{border-color:var(--gold);color:var(--gold);}
.chip.active{background:var(--gold);color:var(--bg);border-color:var(--gold);}

/* ── ACTION BUTTON ── */
.action-btn{background:linear-gradient(135deg,#c9a227,#e8c840,#c9a227);color:var(--bg);font-family:'Cinzel Decorative',serif;font-size:1rem;font-weight:700;padding:.8rem 2.5rem;border:none;border-radius:10px;cursor:pointer;letter-spacing:.05em;transition:all .2s;box-shadow:0 4px 20px #c9a22750;position:relative;overflow:hidden;}
.action-btn::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,255,255,.15) 50%,transparent 60%);transform:translateX(-100%);transition:transform .4s;}
.action-btn:hover:not(:disabled)::after{transform:translateX(100%);}
.action-btn:hover:not(:disabled){box-shadow:0 6px 30px #c9a22770;transform:translateY(-1px);}
.action-btn:disabled{opacity:.4;cursor:not-allowed;transform:none;}

/* ── RESULT NOTIFICATION ── */
.result-box{min-height:60px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;letter-spacing:.05em;padding:1rem 2rem;border-radius:12px;margin:1rem 0;transition:all .3s;opacity:0;transform:translateY(8px);border:1px solid transparent;}
.result-box.show{opacity:1;transform:translateY(0);}
.result-box.win{background:#00ffaa18;border-color:#00ffaa40;color:var(--win);}
.result-box.lose{background:#ff226618;border-color:#ff226640;color:var(--lose);}
.result-box.jackpot{background:#c9a22720;border-color:var(--gold);color:var(--gold-l);font-family:'Cinzel Decorative',serif;}

/* ── COIN FLIP ── */
#coinGame .game-area{display:flex;flex-direction:column;align-items:center;gap:1.5rem;width:100%;max-width:500px;}
.coin-container{width:160px;height:160px;perspective:1000px;cursor:pointer;}
.coin{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform .8s cubic-bezier(.25,.46,.45,.94);}
.coin-face{position:absolute;inset:0;border-radius:50%;backface-visibility:hidden;display:flex;align-items:center;justify-content:center;font-size:3rem;border:4px solid var(--gold-d);}
.coin-face.heads{background:radial-gradient(circle at 35% 35%,#f0d060,#c9a227,#7a5a0a);box-shadow:inset 0 0 20px #00000040,0 0 20px #c9a22750;}
.coin-face.tails{background:radial-gradient(circle at 65% 35%,#c8c8c8,#888,#444);transform:rotateY(180deg);box-shadow:inset 0 0 20px #00000040;}
.coin.flipping{animation:coin-flip 1.2s ease-out forwards;}
@keyframes coin-flip{
  0%{transform:rotateY(0);}
  40%{transform:rotateY(900deg) rotateX(20deg);}
  100%{transform:rotateY(var(--flip-to));}
}
.coin-choice{display:flex;gap:1rem;margin:.5rem 0;}
.choice-btn{background:var(--bg3);border:2px solid var(--border);color:var(--text2);padding:.6rem 1.5rem;border-radius:8px;cursor:pointer;font-family:'Cinzel',serif;font-size:.9rem;transition:all .2s;}
.choice-btn:hover{border-color:var(--gold);color:var(--gold);}
.choice-btn.selected{border-color:var(--gold);background:var(--gold-d);color:var(--gold-l);}

/* ── DICE ── */
#diceGame .game-area{display:flex;flex-direction:column;align-items:center;gap:1.5rem;max-width:500px;width:100%;}
.dice-container{width:120px;height:120px;perspective:800px;margin:1rem 0;}
.dice-3d{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform 1s ease-out;}
.dice-face{position:absolute;inset:0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;padding:14px;border-radius:16px;background:linear-gradient(135deg,#f0e8d0,#c8b890);border:3px solid #8a7040;backface-visibility:hidden;}
.dot{width:16px;height:16px;border-radius:50%;background:#2a1a08;flex-shrink:0;}
.dice-face.f2{transform:rotateY(90deg);}
.dice-face.f3{transform:rotateY(180deg);}
.dice-face.f4{transform:rotateY(-90deg);}
.dice-face.f5{transform:rotateX(-90deg);}
.dice-face.f6{transform:rotateX(90deg);}
.dice-3d.rolling{animation:dice-roll 1.2s ease-out forwards;}
@keyframes dice-roll{
  0%{transform:rotateX(0) rotateY(0) rotateZ(0);}
  30%{transform:rotateX(360deg) rotateY(270deg) rotateZ(180deg);}
  60%{transform:rotateX(720deg) rotateY(450deg) rotateZ(360deg);}
  80%{transform:rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz)) scale(1.05);}
  100%{transform:rotateX(var(--rx)) rotateY(var(--ry)) rotateZ(var(--rz));}
}
.guess-btns{display:grid;grid-template-columns:repeat(6,1fr);gap:.5rem;}
.guess-btn{aspect-ratio:1;background:var(--bg3);border:1px solid var(--border);color:var(--text);border-radius:8px;cursor:pointer;font-family:'Cinzel',serif;font-size:1.1rem;font-weight:700;transition:all .2s;}
.guess-btn:hover{border-color:var(--gold);color:var(--gold);}
.guess-btn.selected{background:var(--gold-d);border-color:var(--gold);color:var(--gold-l);}

/* ── SLOT MACHINE ── */
#slotGame{padding-top:1.5rem;}
.slot-wrapper{width:100%;max-width:900px;}
.slot-machine{background:var(--felt);border:2px solid var(--gold-d);border-radius:20px;padding:1.5rem;position:relative;overflow:hidden;}
.slot-machine::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,#c9a22710 0%,transparent 60%);pointer-events:none;}
.slot-machine-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.2rem;}
.slot-machine-label{font-family:'Cinzel Decorative',serif;font-size:1rem;color:var(--gold);letter-spacing:.1em;}
.payline-toggle{background:none;border:1px solid var(--border);color:var(--text2);padding:.3rem .8rem;border-radius:6px;cursor:pointer;font-family:'Cinzel',serif;font-size:.7rem;letter-spacing:.1em;transition:all .2s;}
.payline-toggle:hover{border-color:var(--gold);color:var(--gold);}

/* ── REELS ── */
.reels-grid{display:flex;gap:6px;justify-content:center;position:relative;}
.reel-wrap{display:flex;flex-direction:column;align-items:center;gap:4px;}
.reel-col-label{font-size:.6rem;color:var(--text3);letter-spacing:.1em;height:12px;}
.reel{width:var(--cell);height:calc(var(--cell) * 3);overflow:hidden;border-radius:8px;border:1px solid var(--gold-d);background:#040c08;position:relative;flex-shrink:0;}
.reel::before,.reel::after{content:'';position:absolute;left:0;right:0;height:30px;z-index:10;pointer-events:none;}
.reel::before{top:0;background:linear-gradient(to bottom,#040c08,transparent);}
.reel::after{bottom:0;background:linear-gradient(to top,#040c08,transparent);}
.reel-strip{position:absolute;top:0;left:0;width:100%;transform:translateY(0);}
.reel-cell{width:var(--cell);height:var(--cell);display:flex;align-items:center;justify-content:center;font-size:2.4rem;border-bottom:1px solid #ffffff0a;user-select:none;transition:background .3s;position:relative;}
.reel-cell[data-sym="7"]{font-family:'Cinzel Decorative',serif;font-size:2rem;color:#ffcc00;text-shadow:0 0 10px #ffcc0080;}
.reel-cell[data-sym="BAR"]{font-size:1rem;font-weight:700;letter-spacing:.1em;color:#c0a060;font-family:'Cinzel Decorative',serif;}
.reel-cell[data-sym="6"]{font-family:'Cinzel Decorative',serif;font-size:2rem;color:#ff2266;text-shadow:0 0 10px #ff226680;}
.reel-cell.win-hl{background:#00ffaa18!important;box-shadow:inset 0 0 12px #00ffaa30;}
.reel-cell.jackpot-hl{background:#c9a22720!important;box-shadow:inset 0 0 12px #c9a22760;animation:jackpot-pulse 0.4s ease-in-out infinite alternate;}
.reel-cell.curse-hl{background:#ff226618!important;box-shadow:inset 0 0 12px #ff226630;}
@keyframes jackpot-pulse{from{box-shadow:inset 0 0 12px #c9a22760;}to{box-shadow:inset 0 0 24px #c9a22799,0 0 20px #c9a22750;}}

/* Active payline overlay */
.payline-overlay{position:absolute;inset:0;pointer-events:none;z-index:5;}
.paylines-wrap{position:relative;}

/* Center line indicator */
.center-line{position:absolute;left:0;right:0;top:calc(var(--cell) + 3px);height:var(--cell);pointer-events:none;z-index:2;}
.center-line::before,.center-line::after{content:'▶';position:absolute;top:50%;transform:translateY(-50%);color:var(--gold);font-size:.7rem;opacity:.5;}
.center-line::before{left:-16px;}
.center-line::after{right:-16px;transform:translateY(-50%) scaleX(-1);}

/* ── SLOT CONTROLS ── */
.slot-controls{display:flex;align-items:center;justify-content:space-between;margin-top:1.2rem;flex-wrap:wrap;gap:1rem;}
.slot-bet-area{display:flex;align-items:center;gap:.5rem;}
.slot-result{flex:1;min-width:200px;text-align:center;}
.spin-btn{background:linear-gradient(135deg,#c9a227,#e8c840,#c9a227);color:var(--bg);font-family:'Cinzel Decorative',serif;font-size:1.1rem;font-weight:700;padding:.7rem 2rem;border:none;border-radius:10px;cursor:pointer;letter-spacing:.05em;transition:all .2s;box-shadow:0 4px 20px #c9a22750;min-width:120px;}
.spin-btn:disabled{opacity:.4;cursor:not-allowed;transform:none!important;}
.spin-btn:not(:disabled):hover{transform:translateY(-2px);box-shadow:0 6px 30px #c9a22770;}

.win-amount{font-family:'Cinzel Decorative',serif;font-size:1.3rem;color:var(--win);text-shadow:0 0 12px #00ffaa60;opacity:0;transition:opacity .3s;}
.win-amount.show{opacity:1;}

/* ── PAYTABLE ── */
.paytable-modal{display:none;position:fixed;inset:0;z-index:100;background:#000000cc;align-items:flex-start;justify-content:center;padding:2rem 1rem;overflow-y:auto;}
.paytable-modal.show{display:flex;}
.paytable-inner{background:var(--bg2);border:1px solid var(--gold-d);border-radius:16px;max-width:700px;width:100%;padding:2rem;position:relative;}
.paytable-close{position:absolute;top:1rem;right:1rem;background:none;border:1px solid var(--border);color:var(--text2);width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:1rem;transition:all .2s;}
.paytable-close:hover{border-color:var(--gold);color:var(--gold);}
.paytable-title{font-family:'Cinzel Decorative',serif;color:var(--gold);font-size:1.2rem;margin-bottom:1.5rem;text-align:center;letter-spacing:.05em;}
.paytable-section{margin-bottom:1.5rem;}
.paytable-section-title{font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text2);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border);}
.pay-grid{display:grid;grid-template-columns:auto 1fr auto auto auto;gap:.5rem .75rem;align-items:center;font-size:.85rem;}
.pay-sym{font-size:1.3rem;text-align:center;}
.pay-name{color:var(--text2);}
.pay-x3,.pay-x4,.pay-x5{text-align:center;font-size:.75rem;}
.pay-x5{color:var(--gold);}
.pay-x3,.pay-x4{color:var(--text2);}
.pay-hdr{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);text-align:center;}
.special-combos{display:flex;flex-direction:column;gap:.75rem;}
.special-combo{display:flex;align-items:center;gap:1rem;padding:.75rem;border-radius:8px;border:1px solid var(--border);}
.special-combo.gold-combo{border-color:var(--gold-d);background:var(--gold-d)20;}
.special-combo.red-combo{border-color:#ff226640;background:#ff226610;}
.special-combo.green-combo{border-color:#00ffaa40;background:#00ffaa10;}
.combo-syms{font-size:1.4rem;letter-spacing:2px;}
.combo-desc{flex:1;}
.combo-name{font-size:.85rem;color:var(--text);}
.combo-payout{font-size:.75rem;color:var(--text2);}
.combo-multi{font-family:'Cinzel Decorative',serif;color:var(--gold);font-size:1rem;white-space:nowrap;}

/* Payline diagram */
.payline-diagram{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-top:.5rem;}
.pline-item{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:.4rem;cursor:pointer;transition:all .2s;}
.pline-item:hover{border-color:var(--gold);}
.pline-mini{display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:repeat(3,1fr);gap:1px;aspect-ratio:5/3;margin-bottom:.3rem;}
.pline-cell{border-radius:2px;background:var(--bg);}
.pline-cell.active{background:var(--gold);}
.pline-label{font-size:.6rem;color:var(--text2);letter-spacing:.05em;text-align:center;}

/* ── FLOAT ANIMATIONS ── */
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
@keyframes glow-pulse{0%,100%{opacity:.7;}50%{opacity:1;}}
@keyframes fade-in{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
.lobby-anim{animation:fade-in .6s ease forwards;}
.game-card{animation:fade-in .5s ease forwards;animation-fill-mode:both;}
.game-card:nth-child(1){animation-delay:.1s;opacity:0;}
.game-card:nth-child(2){animation-delay:.2s;opacity:0;}
.game-card:nth-child(3){animation-delay:.3s;opacity:0;}
@keyframes coin-shine{0%{opacity:0;transform:translateX(-100%);}20%,100%{opacity:0;}10%{opacity:.4;}}

/* ── MISC ── */
.art-deco-border{display:flex;align-items:center;gap:.5rem;margin:1rem 0;}
.art-deco-border::before,.art-deco-border::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold-d),var(--gold),var(--gold-d),transparent);}
.art-deco-border span{color:var(--gold);font-size:1.2rem;}
.jackpot-banner{display:none;position:fixed;inset:0;z-index:200;background:#000000cc;align-items:center;justify-content:center;flex-direction:column;gap:1rem;}
.jackpot-banner.show{display:flex;animation:fade-in .3s ease;}
.jackpot-banner h2{font-family:'Cinzel Decorative',serif;font-size:clamp(2rem,6vw,4rem);color:var(--gold);text-shadow:0 0 30px #c9a22799,0 0 60px #c9a22760;animation:glow-pulse 1s infinite;text-align:center;}
.jackpot-banner p{font-size:1.2rem;color:var(--text);}
.jackpot-banner button{margin-top:1rem;}
.confetti-wrap{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
.confetti-piece{position:absolute;width:8px;height:8px;top:-10px;animation:confetti-fall linear forwards;}
@keyframes confetti-fall{to{transform:translateY(100vh) rotate(720deg);opacity:0;}}
</style>
</head>
<body>

<canvas id="bg"></canvas>

<!-- ══════════════════ LOBBY ══════════════════ -->
<div id="lobby" class="screen active">
  <div class="lobby-anim" style="width:100%;display:flex;flex-direction:column;align-items:center;">
    <div style="color:var(--text3);font-size:.75rem;letter-spacing:.3em;text-transform:uppercase;margin-bottom:.75rem;">✦ ДОБРО ПОЖАЛОВАТЬ ✦</div>
    <h1 class="lobby-title">Казино<br>«Удача»</h1>
    <div class="deco-line"></div>
    <div class="balance-bar">
      <div>
        <div class="balance-label">Ваш баланс</div>
        <div class="balance-coins" id="lobbyCoins">100</div>
      </div>
      <span style="color:var(--text3)">монет</span>
    </div>
    <div class="game-cards">
      <div class="game-card" onclick="showScreen('coinGame')">
        <div class="game-card-badge">1:1</div>
        <span class="game-card-icon">🪙</span>
        <div class="game-card-title">Орёл & Решка</div>
        <div class="game-card-desc">Испытайте удачу — угадайте сторону монеты и удвойте ставку!</div>
      </div>
      <div class="game-card" onclick="showScreen('diceGame')">
        <div class="game-card-badge">1:3</div>
        <span class="game-card-icon">🎲</span>
        <div class="game-card-title">Кубик Удачи</div>
        <div class="game-card-desc">Угадайте точное число от 1 до 6 и утройте свою ставку!</div>
      </div>
      <div class="game-card" onclick="showScreen('slotGame')">
        <div class="game-card-badge">CLOVER PIT</div>
        <span class="game-card-icon" style="font-size:2rem;">🍀💎🍒</span>
        <div class="game-card-title">Слот-машина</div>
        <div class="game-card-desc">5 барабанов × 3 ряда · 20 линий выплат · Джекпот ×100</div>
      </div>
    </div>
