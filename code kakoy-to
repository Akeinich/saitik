    def _on_bet_changed(self, index):
        value = self.bet_combo.itemData(index)
        if value is not None:
            self.bet = int(value)
        self._update_ui()

    def _on_multiplier_changed(self, index):
        key = self.mult_combo.itemData(index)
        if key in MULTIPLIERS:
            self.multiplier_key = key
        chance = MULTIPLIERS[self.multiplier_key]["chance"]
        self.wheel.set_game_state(chance, self.wheel.angle, self.is_spinning)
        self._update_ui()

    def _update_ui(self):
        self.balance_label.setText(f"{money(self.balance)} CR")
        data = MULTIPLIERS[self.multiplier_key]
        payout = self.bet * data["value"]
        self.payout_label.setText(f"×{data['value']:g}  →  {money(payout)} CR")
        self.wheel.set_game_state(data["chance"], self.wheel.angle, self.is_spinning)

        if self.balance < self.bet:
            self.spin_button.setEnabled(False)
            if not self.is_spinning:
                self.status_label.setText("НЕ ХВАТАЕТ СРЕДСТВ")
                self.status_label.setStyleSheet("color: #ff8b9e; background: #421e2a;")
        elif not self.is_spinning:
            self.spin_button.setEnabled(True)
            self.status_label.setText("ИДЁТ ИГРА" if self.is_spinning else "ГОТОВ К ИГРЕ")
            self.status_label.setStyleSheet("")

    def _start_spin(self):
        if self.is_spinning:
            return
        data = MULTIPLIERS[self.multiplier_key]
        if self.balance < self.bet:
            QMessageBox.warning(self, "Недостаточно средств", "Выбери меньшую ставку или получи демонстрационные кредиты.")
            return

        self.balance -= self.bet
        self.is_spinning = True
        self.spin_elapsed = 0
        self.spin_start_angle = self.wheel.angle
        # Визуально вращаем несколько оборотов; исход определяется заданным шансом.
        self.spin_target_angle = self.spin_start_angle + 360 * 5 + random.uniform(0, 359)
        self.spin_success = random.random() < data["chance"] / 100
        self.spin_timer.start()
        self.spin_button.setEnabled(False)
        self.bet_combo.setEnabled(False)
        self.mult_combo.setEnabled(False)
        self.deposit_button.setEnabled(False)
        self.status_label.setText("ВРАЩЕНИЕ…")
        self.status_label.setStyleSheet("color: #ffd58a; background: #42351e;")
        self.result_label.setText("Колесо вращается…")
        self._update_ui()

    def _animate_spin(self):
        self.spin_elapsed += self.spin_timer.interval()
        progress = min(1.0, self.spin_elapsed / self.spin_duration)
        eased = 1 - (1 - progress) ** 4
        angle = self.spin_start_angle + (self.spin_target_angle - self.spin_start_angle) * eased
        self.wheel.set_game_state(
            MULTIPLIERS[self.multiplier_key]["chance"],
            angle,
            True,
        )

        if progress >= 1:
            self.spin_timer.stop()
            self.is_spinning = False
            data = MULTIPLIERS[self.multiplier_key]
            if self.spin_success:
                winnings = self.bet * data["value"]
                self.balance += winnings
                self.result_label.setText(
                    f"УСПЕХ! Выпало {data['chance']}% шанса. "
                    f"Начислено {money(winnings)} CR (включая ставку)."
                )
                self.result_label.setStyleSheet(
                    "color: #8cf0d4; background: #10352d; border: 1px solid #216653; "
                    "border-radius: 10px; padding: 12px 15px;"
                )
                self.status_label.setText("УСПЕШНО")
                self.status_label.setStyleSheet("color: #8cf0d4; background: #14392f;")
            else:
                self.result_label.setText(
                    f"НЕУДАЧА. Ставка {money(self.bet)} CR потеряна. Попробуй ещё раз."
                )
                self.result_label.setStyleSheet(
                    "color: #ff9aa9; background: #3b1b28; border: 1px solid #693044; "
                    "border-radius: 10px; padding: 12px 15px;"
                )
                self.status_label.setText("НЕУДАЧА")
                self.status_label.setStyleSheet("color: #ff9aa9; background: #421e2a;")

            self.bet_combo.setEnabled(True)
            self.mult_combo.setEnabled(True)
            self.deposit_button.setEnabled(True)
            self.spin_button.setEnabled(True)
            self.wheel.set_game_state(data["chance"], angle, False)
            self._update_ui()

    def _add_demo_balance(self):
        if self.is_spinning:
            return
        self.balance += 1000
        self.result_label.setText("На баланс добавлено 1 000 демонстрационных кредитов.")
        self.result_label.setStyleSheet("")
        self._update_ui()


