class ShooterGame(ShowBase):
    def __init__(self):
        super().__init__()

        self.disableMouse()
        self.setBackgroundColor(0.025, 0.035, 0.065, 1)

        # ---------------- КАМЕРА ----------------

        props = WindowProperties()
        props.setCursorHidden(True)
        props.setMouseMode(WindowProperties.M_absolute)
        self.win.requestProperties(props)

        self.heading = 0.0
        self.pitch = 0.0
        self.sensitivity = 0.12
        self.mouse_ready = False

        # Камера не перемещается, только поворачивается.
        self.camera.setPos(0, -18, 3)
        self.camera.setHpr(0, 0, 0)

        self.taskMgr.add(self.update_camera, "update_camera")

        # ---------------- ИГРА ----------------

        self.score = 0
        self.shots = 0
        self.hits = 0
        self.max_targets = 8
        self.targets = []
        self.target_id = 0
        self.game_time = 0.0
        self.spawn_timer = 0.0

        # ---------------- ОСВЕЩЕНИЕ ----------------

        ambient = AmbientLight("ambient")
        ambient.setColor(Vec4(0.35, 0.38, 0.48, 1))
        ambient_np = self.render.attachNewNode(ambient)
        self.render.setLight(ambient_np)

        sun = DirectionalLight("main_light")
        sun.setColor(Vec4(0.85, 0.90, 1.0, 1))
        sun_np = self.render.attachNewNode(sun)
        sun_np.setHpr(-35, -55, 0)
        self.render.setLight(sun_np)

        point = PointLight("arena_light")
        point.setColor(Vec4(0.15, 0.55, 1.0, 1))
        point.setAttenuation(Vec3(1, 0.015, 0.001))
        point_np = self.render.attachNewNode(point)
        point_np.setPos(0, 12, 9)
        self.render.setLight(point_np)

        # ---------------- ОКРУЖЕНИЕ ----------------

        self.build_arena()

        # ---------------- СТРЕЛЬБА ----------------

        self.cTrav = CollisionTraverser()
        self.queue = CollisionHandlerQueue()

        self.ray = CollisionRay()
        self.ray.setFromLens(self.camNode, 0, 0)

        ray_node = CollisionNode("camera_ray")
        ray_node.addSolid(self.ray)
        ray_node.setFromCollideMask(BitMask32.bit(1))
        ray_node.setIntoCollideMask(BitMask32.allOff())

        self.ray_np = self.camera.attachNewNode(ray_node)
        self.cTrav.addCollider(self.ray_np, self.queue)

        # ---------------- ИНТЕРФЕЙС ----------------

        self.create_ui()

        # ---------------- УПРАВЛЕНИЕ ----------------

        self.accept("mouse1", self.shoot)
        self.accept("escape", self.userExit)
        self.accept("r", self.restart)

        # ---------------- ЦИКЛ ИГРЫ ----------------

        self.taskMgr.add(self.spawn_targets, "spawn_targets")
        self.taskMgr.add(self.update_targets, "update_targets")

        self.spawn_initial_targets()

    # ==================================================
    # ОКРУЖЕНИЕ
    # ==================================================

    def build_arena(self):
        floor_maker = CardMaker("floor")
        floor_maker.setFrame(-35, 35, -25, 65)

        floor = self.render.attachNewNode(floor_maker.generate())
        floor.setP(-90)
        floor.setPos(0, 15, 0)
        floor.setColor(0.055, 0.075, 0.12, 1)

        wall_maker = CardMaker("back_wall")
        wall_maker.setFrame(-35, 35, -1, 18)

        wall = self.render.attachNewNode(wall_maker.generate())
        wall.setPos(0, 55, 0)
        wall.setColor(0.075, 0.10, 0.17, 1)

        # Боковые стены
        for x in (-35, 35):
            maker = CardMaker("side_wall")
            maker.setFrame(-25, 65, -1, 18)

            side = self.render.attachNewNode(maker.generate())
            side.setP(-90)
            side.setPos(x, 15, 0)
            side.setColor(0.045, 0.065, 0.11, 1)

        # Разметка пола
        for x in range(-30, 31, 5):
            self.add_line(
                (x, -10, 0.025),
                (x, 55, 0.025),
                (0.12, 0.24, 0.36, 1),
            )

        for y in range(-10, 56, 5):
            self.add_line(
                (-35, y, 0.025),
                (35, y, 0.025),
                (0.12, 0.24, 0.36, 1),
            )

        # Светящиеся акценты
        for x in range(-30, 31, 10):
            self.add_line(
                (x, 54.8, 1),
                (x, 54.8, 10),
                (0.05, 0.65, 1, 1),
            )

    def add_line(self, start, end, color):
        lines = LineSegs()
        lines.setThickness(1.5)
        lines.setColor(*color)
        lines.moveTo(*start)
        lines.drawTo(*end)

        return self.render.attachNewNode(lines.create())

    # ==================================================
    # ИНТЕРФЕЙС
    # ==================================================

    def create_ui(self):
        self.score_text = OnscreenText(
            text="0000",
            pos=(-1.28, 0.88),
            scale=0.09,
            fg=(0.25, 0.85, 1, 1),
            align=TextNode.ALeft,
            mayChange=True,
        )

        OnscreenText(
            text="SCORE",
            pos=(-1.28, 0.79),
            scale=0.04,
            fg=(0.65, 0.75, 0.9, 1),
            align=TextNode.ALeft,
        )

        self.stats_text = OnscreenText(
            text="HITS 0 | SHOTS 0 | ACC 0%",
            pos=(-1.28, 0.68),
            scale=0.042,
            fg=(0.85, 0.9, 1, 1),
            align=TextNode.ALeft,
            mayChange=True,
        )

        self.targets_text = OnscreenText(
            text="TARGETS 0/8",
            pos=(1.27, 0.88),
            scale=0.052,
            fg=(0.3, 1, 0.7, 1),
            align=TextNode.ARight,
            mayChange=True,
        )

        OnscreenText(
            text="A I M   T R A I N E R",
            pos=(0, 0.93),
            scale=0.045,
            fg=(0.65, 0.78, 1, 1),
        )

        OnscreenText(
            text="LMB SHOOT     |     R RESTART     |     ESC EXIT",
            pos=(0, -0.92),
            scale=0.04,
            fg=(0.65, 0.73, 0.85, 1),
        )

        self.crosshair = OnscreenText(
            text="+",
            pos=(0, 0),
            scale=0.075,
            fg=(0.3, 1, 0.75, 1),
            mayChange=True,
        )

        self.hit_text = OnscreenText(
            text="",
            pos=(0, -0.12),
            scale=0.065,
            fg=(0.3, 1, 0.75, 1),
            mayChange=True,
        )

    def update_ui(self):
        accuracy = self.hits / self.shots * 100 if self.shots else 0

        self.score_text.setText(f"{self.score:04d}")
        self.stats_text.setText(
            f"HITS {self.hits} | SHOTS {self.shots} | ACC {accuracy:.1f}%"
        )
        self.targets_text.setText(
            f"TARGETS {len(self.targets)}/{self.max_targets}"
        )

    # ==================================================
    # КАМЕРА И МЫШЬ
    # ==================================================

    def update_camera(self, task):
        if self.win is None:
            return task.cont

        if not self.mouseWatcherNode.hasMouse():
            self.mouse_ready = False
            return task.cont

        pointer = self.win.getPointer(0)
        width = self.win.getXSize()
        height = self.win.getYSize()

        if width <= 0 or height <= 0:
            return task.cont

        center_x = width // 2
        center_y = height // 2

        if not self.mouse_ready:
            self.win.movePointer(0, center_x, center_y)
            self.mouse_ready = True
            return task.cont

        dx = pointer.getX() - center_x
        dy = pointer.getY() - center_y

        self.heading -= dx * self.sensitivity
        self.pitch += dy * self.sensitivity
        self.pitch = max(-75, min(75, self.pitch))

        self.camera.setHpr(self.heading, self.pitch, 0)

        # Сбрасываем положение курсора, не перемещая камеру.
        self.win.movePointer(0, center_x, center_y)

        return task.cont

    # ==================================================
    # МИШЕНИ
    # ==================================================

    def spawn_initial_targets(self):
        for _ in range(self.max_targets):
            self.create_target()

    def create_target(self):
        self.target_id += 1

        target = self.loader.loadModel("models/smiley")
        target.setColor(1, 0.16, 0.20, 1)
        target.setScale(random.uniform(0.85, 1.2))

        target.setPos(
            random.uniform(-14, 14),
            random.uniform(12, 38),
            random.uniform(2, 9),
        )

        target.reparentTo(self.render)

        # Запоминаем исходную высоту для движения без накопления смещения.
        target.setPythonTag("base_z", target.getZ())

        # Отдельная сфера коллизии гарантирует корректную регистрацию попаданий.
        collision = CollisionNode(f"target_collision_{self.target_id}")
        collision.addSolid(CollisionSphere(0, 0, 0, 1.0))
        collision.setIntoCollideMask(BitMask32.bit(1))
        collision.setFromCollideMask(BitMask32.allOff())

        collision_np = target.attachNewNode(collision)
        collision_np.setPythonTag("target", target)

        self.targets.append(target)
        self.update_ui()

    def spawn_targets(self, task):
        dt = ClockObject.getGlobalClock().getDt()
        self.spawn_timer += dt

        if (
            len(self.targets) < self.max_targets
            and self.spawn_timer >= 0.4
        ):
            self.spawn_timer = 0.0
            self.create_target()

        return task.cont

    def update_targets(self, task):
        self.game_time += ClockObject.getGlobalClock().getDt()

        for index, target in enumerate(self.targets):
            base_z = target.getPythonTag("base_z")
            phase = self.game_time * 1.2 + index * 1.7

            target.setZ(base_z + math.sin(phase) * 0.35)

        return task.cont

    # ==================================================
    # СТРЕЛЬБА
    # ==================================================

    def shoot(self):
        self.shots += 1
        self.hit_text.setText("")

        self.queue.clearEntries()
        self.cTrav.traverse(self.render)

        hit = False

        if self.queue.getNumEntries() > 0:
            self.queue.sortEntries()

            for index in range(self.queue.getNumEntries()):
                entry = self.queue.getEntry(index)
                hit_node = entry.getIntoNodePath()

                if not hit_node.hasPythonTag("target"):
                    continue

                target = hit_node.getPythonTag("target")

                if target not in self.targets:
                    continue

                self.targets.remove(target)
                target.removeNode()

                self.score += 100
                self.hits += 1
                hit = True

                self.hit_text.setText("HIT  +100")
                break

        if hit:
            self.crosshair.setFg((1, 0.85, 0.25, 1))
        else:
            self.crosshair.setFg((1, 0.3, 0.3, 1))

        self.taskMgr.remove("reset_crosshair")
        self.taskMgr.doMethodLater(
            0.12,
            self.reset_crosshair,
            "reset_crosshair",
        )

        self.update_ui()

    def reset_crosshair(self, task):
        self.crosshair.setFg((0.3, 1, 0.75, 1))
        return task.done

    # ==================================================
    # ПЕРЕЗАПУСК
    # ==================================================

    def restart(self):
        for target in self.targets:
            target.removeNode()

        self.targets.clear()

        self.score = 0
        self.shots = 0
        self.hits = 0
        self.game_time = 0.0
        self.spawn_timer = 0.0

        self.heading = 0.0
        self.pitch = 0.0
        self.camera.setHpr(0, 0, 0)
        self.mouse_ready = False

        self.hit_text.setText("")
        self.crosshair.setFg((0.3, 1, 0.75, 1))

        self.spawn_initial_targets()
        self.update_ui()


app = ShooterGame()
app.run()
