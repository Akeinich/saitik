    AmbientLight,
    DirectionalLight,
    PointLight,
    Vec4,
    Vec3,
    CollisionTraverser,
    CollisionHandlerQueue,
    CollisionNode,
    CollisionRay,
    CollisionSphere,
    BitMask32,
    CardMaker,
    LineSegs,
    loadPrcFileData,
    ClockObject,
)
import random
import math


# ---------------- НАСТРОЙКИ ----------------

loadPrcFileData("", "window-title Aim Trainer")
loadPrcFileData("", "win-size 1280 720")
loadPrcFileData("", "fullscreen false")
loadPrcFileData("", "sync-video true")
loadPrcFileData("", "show-frame-rate-meter false")
