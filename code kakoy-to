from direct.showbase.ShowBase import ShowBase
from direct.task import Task
from direct.gui.OnscreenText import OnscreenText
from panda3d.core import (
    TextNode, 
    CollisionTraverser, CollisionHandlerQueue, 
    CollisionNode, CollisionRay,
    loadPrcFileData,
    WindowProperties,
    Vec3
)
import random

# Включаем фуллскрин ДО инициализации движка
loadPrcFileData("", "fullscreen true")
loadPrcFileData("", "win-size 1920 1080")
loadPrcFileData("", "sync-video false")

class ShooterGame(ShowBase):
    def __init__(self):
        ShowBase.__init__(self)

        # --- НАСТРОЙКА МЫШИ (КАК В ШУТЕРАХ) ---
        self.disableMouse()
        props = WindowProperties()
        props.setCursorHidden(True)
        props.setMouseMode(WindowProperties.M_confined)
        self.win.requestProperties(props)
        
        # Камера
        self.camera.setPos(0, -15, 2)
        self.camera.lookAt(0, 100, 2)

        self.heading = 0
        self.pitch = 0
        self.taskMgr.add(self.update_camera, "UpdateCameraTask")

        # --- GAME SETTINGS ---
        self.score = 0
        self.max_targets = 8
        self.targets = []

        # --- UI ---
        self.score_text = OnscreenText(
            text="Score: 0", pos=(-1.3, 0.9), scale=0.07, 
            fg=(1, 1, 1, 1), align=TextNode.ALeft
        )
        
        self.crosshair = OnscreenText(
            text="+", pos=(0, 0), scale=0.1, fg=(0, 1, 0, 1)
        )

        # --- ENVIRONMENT ---
        self.environ = self.loader.loadModel("models/environment")
        self.environ.reparentTo(self.render)
        self.environ.setScale(0.25, 0.25, 0.25)
        self.environ.setPos(-8, 42, 0)

        # --- PHYSICS (Выстрелы) ---
        self.cTrav = CollisionTraverser()
        self.queue = CollisionHandlerQueue()
        
        # Создаем узел стрельбы. Он привязан к камере, но находится в пространстве render
        self.shoot_node = self.render.attachNewNode("shoot_node")
        self.shoot_node.setPos(self.camera.getPos(self.render))
        
        # Создаем луч
        self.ray = CollisionRay()
        # Луч летит из начала координат (0,0,0) вперед по оси Y на 200 метров
        self.ray.setOrigin(0, 0, 0)
        self.ray.setDirection(0, 1, 0)
        
        # Оборачиваем луч в узел коллизии
        ray_node = CollisionNode("shoot_ray")
        ray_node.addSolid(self.ray)
        ray_np = self.shoot_node.attachNewNode(ray_node)
        
        # Подключаем к трекеру
        self.cTrav.addCollider(ray_np, self.queue)
        
        # Делаем луч "из камеры"
        self.shoot_node.setPos(self.camera.getPos(self.render))
        # Синхронизируем поворот узла стрельбы с камерой каждый кадр
        self.shoot_task = self.taskMgr.add(self.update_shoot_node, "UpdateShootNodeTask")

        # --- START GAME LOOP ---
        self.taskMgr.add(self.spawn_targets, "SpawnTargetsTask")

        # Клик = выстрел
        self.accept("mouse1", self.shoot)
        
        # Выход по Escape
        self.accept("escape", self.userExit)

    def update_camera(self, task):
        if self.mouseWatcherNode.hasMouse():
            mw = self.mouseWatcherNode
            x = mw.getMouseX()
            y = mw.getMouseY()

            self.heading -= x * 50 * globalClock.getDt()
            self.pitch += y * 50 * globalClock.getDt()
            self.pitch = max(-70, min(70, self.pitch))
            self.camera.setHpr(self.heading, self.pitch, 0)

        return task.cont

    def update_shoot_node(self, task):
        # Каждый кадр ставим узел стрельбы туда же, куда смотрит камера
        self.shoot_node.setPos(self.camera.getPos(self.render))
        self.shoot_node.setHpr(self.camera.getHpr(self.render))
        return task.cont

    def spawn_targets(self, task):
        if len(self.targets) < self.max_targets:
            target = self.loader.loadModel("models/smiley")
            target.setTextureOff(1)      
            target.setColor(1, 0, 0, 1)  
            target.setScale(1.5)
            
            x = random.uniform(-20, 20)
            y = random.uniform(20, 50) # Чуть дальше, чтобы не в лицо
            z = random.uniform(-2, 10)
            
            target.setPos(x, y, z)
            target.reparentTo(self.render)
            self.targets.append(target)
            
        return task.again

    def shoot(self):
        # Очищаем очередь от прошлых выстрелов
        self.queue.clearEntries()
        
        # Трейсер просчитывает пересечения
        self.cTrav.traverse(self.render)
        
        # Если во что-то попали
        if self.queue.getNumEntries() > 0:
            self.queue.sortEntries() # Берем самое близкое
            
            # Получаем объект, в который попали
            hit_object = self.queue.getEntry(0).getIntoNodePath()
            
            # Проверяем, является ли этот объект мишенью (или его родителем)
            parent = hit_object.getParent()
            while parent:
                if parent in self.targets:
                    # Попадание!
                    self.targets.remove(parent)
                    parent.removeNode()
                    self.score += 1
                    self.score_text.setText(f"Score: {self.score}")
                    break
                parent = parent.getParent()

app = ShooterGame()
app.run()
