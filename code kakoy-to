def money(value: float) -> str:
    """Форматирует игровую валюту."""
    if float(value).is_integer():
        return f"{int(value):,}".replace(",", " ")
    return f"{value:,.2f}".replace(",", " ")


class UpgradeWheel(QWidget):
    """Самостоятельно рисуемое колесо: сектор успеха и неподвижная стрелка."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumSize(300, 300)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.angle = 0.0
        self.chance = 70
        self.spinning = False
        self.setAttribute(Qt.WidgetAttribute.WA_OpaquePaintEvent, False)

    def set_game_state(self, chance: int, angle: float, spinning: bool = False):
        self.chance = max(1, min(99, int(chance)))
        self.angle = float(angle)
        self.spinning = spinning
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        painter.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)

        # Весь рисунок помещается в доступную область, независимо от размера окна.
        side = min(self.width(), self.height()) - 24
        if side < 20:
            painter.end()
            return

        center = QPointF(self.width() / 2, self.height() / 2)
        radius = side / 2
        outer = QRectF(center.x() - radius, center.y() - radius, side, side)

        # Мягкое внешнее свечение и обод.
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor("#1d2b49"))
        painter.drawEllipse(outer.adjusted(-4, -4, 4, 4))

        painter.setPen(QPen(QColor("#314467"), max(2, side * 0.018)))
        painter.setBrush(QColor("#10182a"))
        painter.drawEllipse(outer)

        # Колесо целиком вращается; зелёный сектор показывает вероятность успеха.
        wheel_rect = outer.adjusted(side * 0.07, side * 0.07, -side * 0.07, -side * 0.07)
        span = int(360 * 16 * self.chance / 100)
        start = int((90 + self.angle) * 16)

        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor("#24314b"))
        painter.drawPie(wheel_rect, 0, 360 * 16)

        painter.setBrush(QColor(GREEN))
        painter.drawPie(wheel_rect, start, span)

        # Тонкие отметки по окружности.
        tick_radius = radius * 0.88
        for i in range(40):
            a = math.radians(i * 9 + self.angle)
            inner_r = tick_radius - (9 if i % 5 == 0 else 4)
            x1 = center.x() + math.cos(a) * inner_r
            y1 = center.y() - math.sin(a) * inner_r
            x2 = center.x() + math.cos(a) * tick_radius
            y2 = center.y() - math.sin(a) * tick_radius
            pen = QPen(QColor("#dce5ff" if i % 5 == 0 else "#7182a5"))
            pen.setWidthF(2.4 if i % 5 == 0 else 1.2)
            pen.setCapStyle(Qt.PenCapStyle.FlatCap)
            painter.setPen(pen)
            painter.drawLine(QPointF(x1, y1), QPointF(x2, y2))

        # Подпись вероятности в центре.
        painter.setPen(QPen(QColor("#0b342c") if self.chance >= 50 else QColor(TEXT)))
        font = QFont("Segoe UI", max(15, int(side * 0.085)), QFont.Weight.Bold)
        painter.setFont(font)
        painter.drawText(wheel_rect, Qt.AlignmentFlag.AlignCenter, f"{self.chance}%")

        # Центральная втулка.
        hub_size = side * 0.18
        hub = QRectF(center.x() - hub_size / 2, center.y() - hub_size / 2, hub_size, hub_size)
        painter.setPen(QPen(QColor("#3c4d70"), 2))
        painter.setBrush(QColor("#111a2c"))
        painter.drawEllipse(hub)
        painter.setPen(QPen(QColor(TEXT)))
        painter.setFont(QFont("Segoe UI", max(8, int(side * 0.027)), QFont.Weight.DemiBold))
        painter.drawText(hub, Qt.AlignmentFlag.AlignCenter, "UP")

        # Стрелка в верхней части колеса.
        tip_y = center.y() - radius + side * 0.025
        base_y = tip_y + side * 0.105
        tip = QPointF(center.x(), tip_y)
        left = QPointF(center.x() - side * 0.045, base_y)
        right = QPointF(center.x() + side * 0.045, base_y)
        painter.setPen(QPen(QColor("#0a1020"), 2))
        painter.setBrush(QColor(GOLD))
        from PySide6.QtGui import QPolygonF
        painter.drawPolygon(QPolygonF([tip, left, right]))

        painter.end()


