@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700;800&display=swap');

:root {
    color-scheme: dark;
    /* НОВАЯ ЛЕСНАЯ ПАЛИТРА */
    --bg: #061008; /* Глубокий темно-зеленый (ночь в лесу) */
    --panel: rgba(18, 38, 24, .78); /* Панели цвета мха */
    --line: rgba(123, 237, 159, .2); /* Линии цвета молодой травы */
    --text: #f0fdf4; /* Светло-зеленоватый белый */
    --muted: #86a890; /* Приглушенный болотный */
    --gold: #ffd700; /* Оставили золото для контраста */
    --gold-deep: #b88a00;
    --blue: #4ade80; /* Заменили синий на яркий зеленый */
    --purple: #86efac; /* Заменили фиолетовый на светло-зеленый */
    --danger: #ff6b6b;
}

* {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    background: var(--bg);
}

body {
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    color: var(--text);
    font-family: Manrope, Segoe UI, sans-serif;
    background: #061008;
}

button {
    font: inherit;
}

    button:focus-visible, a:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 4px;
    }

/* ОБНОВЛЕННЫЙ ФОН */
.site-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: radial-gradient(ellipse at 50% -15%, #1a3b22 0, transparent 48%), radial-gradient(ellipse at 85% 70%, rgba(26, 90, 39, .2), transparent 45%), linear-gradient(145deg, #0a1a0f, #061008 58%, #041206);
}

#ambient-canvas {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: .65;
}

.topbar {
    min-height: 76px;
    padding: 14px clamp(18px, 5vw, 76px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid rgba(123, 237, 159, .1);
    background: rgba(6, 16, 8, .65);
    backdrop-filter: blur(18px);
    position: relative;
    z-index: 10;
}

.brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text);
    text-decoration: none;
    font-weight: 800;
    letter-spacing: .12em;
    font-size: 1.05rem;
}

.brand-mark {
    color: var(--gold);
    font-size: 1.7rem;
    text-shadow: 0 0 18px rgba(245, 217, 154, .7);
}

.brand-accent {
    color: var(--gold);
}

.brand-subtitle {
    margin-left: 8px;
    padding-left: 14px;
    border-left: 1px solid var(--line);
    color: var(--muted);
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .02em;
}

.topbar-actions {
    display: flex;
    align-items: center;
    gap: 14px;
}

.balance-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border: 1px solid rgba(245, 217, 154, .25);
    border-radius: 999px;
    background: rgba(245, 217, 154, .07);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
}

.balance-gem, .wish-button-cost i {
    color: var(--gold);
    font-style: normal;
    text-shadow: 0 0 12px rgba(245, 217, 154, .6);
}

.balance-label {
    color: var(--muted);
    font-size: .68rem;
    font-weight: 600;
}

.button {
    border: 0;
    border-radius: 9px;
    padding: 11px 17px;
    cursor: pointer;
    font-weight: 800;
    transition: transform .2s, filter .2s, background .2s;
}

    .button:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .button:disabled {
        opacity: .5;
        cursor: wait;
        transform: none;
    }

.button-quiet {
    color: #a7f3d0;
    background: rgba(255,255,255,.045);
    border: 1px solid var(--line);
}

.page-shell {
    width: min(1100px, calc(100% - 40px));
    margin: 34px auto 22px;
    position: relative;
    z-index: 10;
}

/* ОБНОВЛЕННЫЙ БАННЕР */
.hero-banner {
    position: relative;
    min-height: 340px;
    overflow: hidden;
    display: flex;
    align-items: center;
    border: 1px solid rgba(123, 237, 159, .2);
    border-radius: 20px;
    background: linear-gradient(105deg, rgba(15, 40, 20, .98), rgba(8, 25, 12, .9) 53%, rgba(20, 50, 30, .84)), radial-gradient(circle at 78% 48%, #2d6a4f, transparent 32%);
    box-shadow: 0 28px 70px rgba(0,0,0,.28), inset 0 0 70px rgba(123, 237, 159, .06);
}

    .hero-banner::before {
        content: "";
        position: absolute;
        inset: 0;
        opacity: .18;
        background-image: linear-gradient(115deg, transparent 0 48%, rgba(255,255,255,.3) 49%, transparent 50%), radial-gradient(circle, #fff 1px, transparent 1.5px);
        background-size: 100% 100%, 47px 47px;
        mask-image: linear-gradient(90deg, transparent, #000);
    }

.banner-copy {
    position: relative;
    z-index: 3;
    width: 64%;
    padding: 48px clamp(24px, 5vw, 66px);
}

.eyebrow, .section-kicker, .cinematic-kicker {
    color: var(--gold);
    font-size: .67rem;
    letter-spacing: .19em;
    font-weight: 800;
}

.live-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: #7bed9f;
    box-shadow: 0 0 12px #7bed9f;
}

.banner-copy h1 {
    max-width: 640px;
    margin: 18px 0 12px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -.035em;
    color: #fff;
}

    .banner-copy h1 span {
        color: var(--gold);
        text-shadow: 0 4px 30px rgba(245, 217, 154, .22);
    }

.banner-description {
    color: #a7f3d0;
    font-size: .95rem;
    line-height: 1.7;
}

.banner-rates {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 24px;
}

.rate {
    display: inline-flex;
    gap: 9px;
    align-items: center;
    padding: 7px 11px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 6px;
    background: rgba(0,0,0,.3);
    font-size: .75rem;
    letter-spacing: .08em;
}

    .rate b {
        color: white;
        letter-spacing: 0;
    }

.rate-five {
    color: #ffdb83;
}

.rate-four {
    color: #86efac;
}
/* Сделали эпических светло-зелеными */
.rate-three {
    color: #4ade80;
}
/* Обычные - зелеными */
.banner-disclaimer {
    display: block;
    margin-top: 17px;
    color: #5c8a6b;
    font-size: .65rem;
}

/* Pity Bar */
.pity-container {
    margin-top: 20px;
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px 15px;
    width: 100%;
    max-width: 400px;
}

.pity-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--muted);
}

.guarantee-status {
    color: var(--gold);
    font-weight: 800;
    transition: color 0.3s;
}

    .guarantee-status.is-guaranteed {
        color: #ff4d4d;
        text-shadow: 0 0 10px rgba(255, 77, 77, 0.5);
    }

.pity-bar-bg {
    height: 8px;
    background: rgba(255,255,255,0.1);
    border-radius: 4px;
    overflow: hidden;
}

.pity-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #4ade80, #86efac, #ffd700);
    width: 0%;
    transition: width 0.3s ease-out, background 0.3s;
}

    .pity-bar-fill.is-guaranteed {
        background: linear-gradient(90deg, #ff6b6b, #ffd700);
    }

.banner-art {
    position: absolute;
    right: 4%;
    top: 0;
    width: 38%;
    height: 100%;
    display: grid;
    place-items: center;
}

.art-halo {
    position: absolute;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 224, 165, .25), rgba(123, 237, 159, .1) 42%, transparent 70%);
    filter: blur(8px);
    animation: haloPulse 4s ease-in-out infinite;
}

.art-ring {
    position: absolute;
    width: 235px;
    height: 235px;
    border: 1px solid rgba(246, 219, 173, .32);
    border-radius: 50%;
    transform: rotateX(65deg) rotate(-25deg);
}

.ring-b {
    width: 190px;
    height: 190px;
    border-color: rgba(123, 237, 159, .4);
    transform: rotateX(65deg) rotate(35deg);
}

.art-crystal {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 126px;
    height: 150px;
    color: #fff0c6;
    font-size: 5rem;
    text-shadow: 0 0 22px #eacb92, 0 0 65px #7bed9f;
    animation: crystalFloat 4s ease-in-out infinite;
}

    .art-crystal::before {
        content: "";
        position: absolute;
        inset: 15px 12px;
        border: 1px solid rgba(255, 238, 202, .55);
        transform: rotate(45deg) skew(-8deg,-8deg);
        background: linear-gradient(135deg, rgba(255,255,255,.17), rgba(123, 237, 159, .08));
        clip-path: polygon(50% 0,100% 35%,78% 100%,22% 100%,0 35%);
    }

.art-caption {
    position: absolute;
    right: 2%;
    bottom: 13%;
    color: rgba(255,255,255,.5);
    font-size: .55rem;
    line-height: 1.5;
    letter-spacing: .2em;
    text-align: right;
}

    .art-caption strong {
        color: var(--gold);
        font-size: .9rem;
    }

.banner-orbit {
    position: absolute;
    width: 340px;
    height: 340px;
    border: 1px solid rgba(123, 237, 159, .08);
    border-radius: 50%;
    right: 7%;
    top: -130px;
}

.orbit-two {
    width: 430px;
    height: 430px;
    right: 2%;
    top: -170px;
    border-style: dashed;
    animation: orbit 40s linear infinite;
}

.banner-sparkle {
    position: absolute;
    color: #fff2ce;
    text-shadow: 0 0 18px #f5d99a;
    animation: twinkle 2s ease-in-out infinite;
}

.sparkle-one {
    top: 22%;
    right: 35%;
    font-size: 1.5rem;
}

.sparkle-two {
    bottom: 24%;
    right: 12%;
    font-size: 2rem;
    animation-delay: .8s;
}

.banner-bottom-line {
    position: absolute;
    bottom: 0;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(123, 237, 159, .7), transparent);
}

.wish-section {
    margin-top: 39px;
}

.section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 17px;
}

    .section-heading h2 {
        margin: 7px 0 0;
        font-family: "Playfair Display", Georgia, serif;
        font-size: 1.65rem;
    }

.pity-note {
    color: #86a890;
    font-size: .72rem;
    padding-bottom: 5px;
}

    .pity-note span {
        color: var(--gold);
        margin-right: 5px;
    }

/* ОБНОВЛЕННЫЕ КНОПКИ ПРИЗЫВА */
.wish-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.wish-button {
    position: relative;
    min-height: 86px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 23px;
    text-align: left;
    color: var(--text);
    cursor: pointer;
    border: 1px solid rgba(123, 237, 159, .22);
    border-radius: 12px;
    background: linear-gradient(105deg, rgba(20, 50, 30, .9), rgba(10, 30, 15, .9));
    transition: transform .2s, border-color .2s, box-shadow .2s;
}

    .wish-button:hover {
        transform: translateY(-3px);
        border-color: rgba(245, 217, 154, .65);
        box-shadow: 0 12px 35px rgba(0,0,0,.25), 0 0 25px rgba(123, 237, 159, .08);
    }

    .wish-button:disabled {
        opacity: .5;
        cursor: wait;
        transform: none;
    }

.wish-button-featured {
    border-color: rgba(245, 217, 154, .42);
    background: linear-gradient(105deg, rgba(40, 80, 50, .9), rgba(15, 40, 20, .95));
}

.wish-button-icon {
    color: var(--gold);
    font-size: 2rem;
    text-shadow: 0 0 18px rgba(245, 217, 154, .5);
}

.wish-button-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
}

    .wish-button-copy strong {
        font-size: .95rem;
    }

    .wish-button-copy small {
        color: var(--muted);
        font-size: .72rem;
    }

.wish-button-cost {
    font-size: 1.15rem;
    font-weight: 800;
    white-space: nowrap;
}

    .wish-button-cost i {
        margin-left: 4px;
    }

.ten-badge {
    position: absolute;
    top: -9px;
    right: 16px;
    padding: 3px 8px;
    border-radius: 4px;
    background: #4ade80;
    color: #061008;
    font-size: .55rem;
    letter-spacing: .1em;
    font-weight: 900;
}

/* ОБНОВЛЕННЫЙ БЛОК ДОБЫЧИ */
.side-activity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 22px;
    padding: 18px 23px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    backdrop-filter: blur(12px);
}

.activity-copy {
    display: flex;
    align-items: center;
    gap: 17px;
}

.activity-icon {
    display: grid;
    place-items: center;
    width: 47px;
    height: 47px;
    border-radius: 50%;
    color: var(--gold);
    background: rgba(123, 237, 159, .09);
    font-size: 1.5rem;
}

.activity-copy h3 {
    margin: 5px 0 3px;
    font-size: .98rem;
}

.activity-copy p {
    margin: 0;
    color: var(--muted);
    font-size: .72rem;
}

    .activity-copy p b {
        color: var(--gold);
    }

.farm-control {
    display: flex;
    align-items: center;
    gap: 15px;
}

.farm-orb {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(123, 237, 159, .55);
    border-radius: 50%;
    color: #fff0bf;
    font-size: 1.8rem;
    cursor: pointer;
    background: radial-gradient(circle at 35% 25%, #fff0c5, #4ade80 38%, #2d6a4f 72%);
    box-shadow: 0 0 22px rgba(123, 237, 159, .32), inset 0 0 12px rgba(255,255,255,.4);
    transition: transform .15s, box-shadow .15s;
}

    .farm-orb:hover {
        transform: scale(1.08);
        box-shadow: 0 0 32px rgba(123, 237, 159, .5);
    }

    .farm-orb:active {
        transform: scale(.9);
    }

.farm-stats {
    min-width: 76px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-variant-numeric: tabular-nums;
}

    .farm-stats strong {
        font-size: .95rem;
    }

    .farm-stats small {
        color: var(--muted);
        font-size: .61rem;
    }

.page-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 27px;
    padding: 14px 2px;
    color: #4a6b53;
    font-size: .62rem;
}

/* Gacha Overlay */
.gacha-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(ellipse at 50% 45%, #0f2e18, #061008 68%, #020402);
}

    .gacha-overlay.active {
        display: block;
        animation: overlayIn .45s ease both;
    }

#scene-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

.scene-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 22%, rgba(0,0,0,.32) 72%, rgba(0,0,0,.82));
}

.scene-topline {
    position: absolute;
    top: 25px;
    left: 34px;
    right: 34px;
    display: flex;
    justify-content: space-between;
    color: rgba(238,232,255,.55);
    font-size: .62rem;
    letter-spacing: .18em;
    z-index: 10;
}

.skip-button {
    position: absolute;
    top: 18px;
    right: 28px;
    z-index: 20;
    padding: 8px 14px;
    color: #e7e0f5;
    background: rgba(10,10,25,.35);
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 5px;
    cursor: pointer;
    font-size: .72rem;
    backdrop-filter: blur(8px);
}

    .skip-button span {
        color: var(--gold);
        font-size: 1.1rem;
        margin-left: 5px;
    }

.cinematic-message {
    position: absolute;
    top: 25%;
    left: 50%;
    width: min(90%, 520px);
    transform: translate(-50%,-50%);
    text-align: center;
    z-index: 5;
    transition: opacity .45s, transform .45s;
}

    .cinematic-message.hidden {
        opacity: 0;
        transform: translate(-50%,-42%);
        pointer-events: none;
    }

    .cinematic-message h2 {
        margin: 16px 0 8px;
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(2rem, 5vw, 3.7rem);
        text-shadow: 0 5px 30px rgba(0,0,0,.7);
    }

    .cinematic-message p {
        margin: 0;
        color: rgba(240,235,255,.75);
        font-size: .9rem;
    }

.cinematic-loading {
    width: 120px;
    height: 2px;
    margin: 27px auto 0;
    overflow: hidden;
    background: rgba(255,255,255,.18);
}

    .cinematic-loading span {
        display: block;
        width: 40%;
        height: 100%;
        background: var(--gold);
        animation: loadingSweep 1.1s ease-in-out infinite;
    }

.rarity-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transform: scale(.92);
    transition: opacity .45s, transform .55s, visibility .45s;
    z-index: 7;
}

    .rarity-reveal.active {
        opacity: 1;
        visibility: visible;
        transform: scale(1);
    }

.reveal-rays {
    position: absolute;
    width: min(80vw, 650px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, rgba(255,255,255,.13) 0deg 2deg, transparent 2deg 12deg);
    mask-image: radial-gradient(circle, #000 0, transparent 68%);
    animation: raySpin 35s linear infinite;
}

.reveal-stars {
    position: relative;
    z-index: 1;
    font-size: clamp(2.4rem, 7vw, 5.5rem);
    letter-spacing: .16em;
    color: var(--rarity);
    text-shadow: 0 0 14px var(--rarity), 0 0 45px var(--rarity);
    animation: starsPop .65s cubic-bezier(.2,1.5,.4,1) both;
}

.reveal-label {
    position: relative;
    z-index: 1;
    margin-top: 16px;
    color: var(--rarity);
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .32em;
    text-shadow: 0 0 18px var(--rarity);
}

.reveal-name {
    position: relative;
    z-index: 1;
    margin-top: 18px;
    max-width: 90%;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(1.7rem, 4vw, 3rem);
    text-shadow: 0 4px 30px rgba(0,0,0,.8);
}

.reveal-hint {
    position: relative;
    z-index: 1;
    margin-top: 36px;
    color: rgba(255,255,255,.72);
    font-size: .68rem;
    letter-spacing: .14em;
    animation: hintBlink 1.7s infinite;
}

/* ОБНОВЛЕНИЕ РЕДКОСТЕЙ */
.rarity-3 {
    --rarity: #4ade80;
}
/* Обычные - зеленые */
.rarity-4 {
    --rarity: #86efac;
}
/* Эпические - светло-зеленые */
.rarity-5 {
    --rarity: #ffd700;
    text-shadow: 0 0 20px #ffd700, 0 0 40px #ffaa00;
}

.summary-screen {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 78px 5vw 45px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(15px);
    transition: .4s;
    z-index: 8;
}

    .summary-screen.active {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

.summary-header {
    text-align: center;
}

    .summary-header h2 {
        margin: 9px 0 5px;
        font-family: "Playfair Display", Georgia, serif;
        font-size: clamp(1.8rem, 4vw, 2.7rem);
    }

    .summary-header p {
        margin: 0;
        color: #a7f3d0;
        font-size: .8rem;
    }

.summary-grid {
    width: min(100%, 920px);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 11px;
    margin: 27px auto 20px;
}

.summary-card {
    min-height: 138px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 13px 8px;
    border: 1px solid var(--rarity);
    border-radius: 9px;
    background: linear-gradient(155deg, rgba(20, 40, 25, 0.9), rgba(5, 15, 8, .92));
    box-shadow: inset 0 0 22px rgba(255, 255, 255, 0.05);
    text-align: center;
    animation: cardIn .45s both;
}

    .summary-card .card-stars {
        color: var(--rarity);
        font-size: .86rem;
        letter-spacing: .1em;
        text-shadow: 0 0 12px var(--rarity);
    }

    .summary-card .card-icon {
        font-size: 1.7rem;
        filter: drop-shadow(0 0 10px var(--rarity));
    }

    .summary-card .card-name {
        color: #f5f0ff;
        font-size: .67rem;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .summary-card.rarity-5 {
        border: 2px solid #ffd700;
        box-shadow: 0 0 30px rgba(255, 215, 0, 0.6), inset 0 0 20px rgba(255, 215, 0, 0.2);
        background: linear-gradient(135deg, rgba(50, 40, 0, 0.9), rgba(0, 0, 0, 0.95));
    }

        .summary-card.rarity-5 .card-name {
            color: #ffd700;
            text-shadow: 0 0 10px #ffd700;
            font-weight: 900;
            letter-spacing: 1px;
        }

.summary-footer {
    width: min(100%, 920px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.summary-total {
    color: #a7f3d0;
    font-size: .78rem;
}

    .summary-total strong {
        color: var(--gold);
    }

.button-gold {
    color: #241b12;
    background: linear-gradient(135deg, #ffe6ac, #c69a5b);
    box-shadow: 0 5px 25px rgba(213,171,105,.2);
}

.scene-bottom-hint {
    position: absolute;
    bottom: 25px;
    left: 0;
    right: 0;
    text-align: center;
    color: rgba(255,255,255,.45);
    font-size: .6rem;
    letter-spacing: .2em;
    z-index: 9;
}

    .scene-bottom-hint.hidden {
        display: none;
    }

@keyframes overlayIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes haloPulse {
    50% {
        transform: scale(1.12);
        opacity: .7;
    }
}

@keyframes crystalFloat {
    50% {
        transform: translateY(-13px) rotate(5deg);
    }
}

@keyframes orbit {
    to {
        transform: rotate(360deg);
    }
}

@keyframes twinkle {
    50% {
        opacity: .25;
        transform: scale(.7);
    }
}

@keyframes loadingSweep {
    from {
        transform: translateX(-120%);
    }

    to {
        transform: translateX(300%);
    }
}

@keyframes raySpin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes starsPop {
    from {
        opacity: 0;
        transform: scale(.4) translateY(20px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

@keyframes hintBlink {
    50% {
        opacity: .35;
    }
}

@keyframes cardIn {
    from {
        opacity: 0;
        transform: translateY(18px) scale(.96);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

/* =========================================
   МАСКОТ: ЧИБИ-ДРИАДА И ФУНКЦИОНАЛ
   ========================================= */

.fairy-mascot {
    position: fixed;
    bottom: 10%;
    left: 5%;
    width: 150px;
    height: 150px;
    z-index: 50;
    animation: floatDryad 4s ease-in-out infinite;
    cursor: pointer;
}

.fairy-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(100, 255, 150, 0.15) 0%, transparent 70%);
    border-radius: 50%;
    animation: pulseGlow 3s infinite alternate;
    pointer-events: none;
}

.fairy-particles {
    position: absolute;
    inset: -50px;
    pointer-events: none;
}

.leaf {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #7bed9f;
    border-radius: 0 50% 0 50%;
    box-shadow: 0 0 8px #7bed9f;
    opacity: 0;
}

.leaf-1 {
    top: 20%;
    left: 10%;
    animation: flyLeaf 5s linear infinite;
}

.leaf-2 {
    top: 70%;
    left: 80%;
    animation: flyLeaf 6s linear 2s infinite;
}

.leaf-3 {
    top: 10%;
    left: 90%;
    animation: flyLeaf 4s linear 4s infinite;
}

.firefly {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #e0ff99;
    border-radius: 50%;
    box-shadow: 0 0 10px 2px #e0ff99;
    opacity: 0;
}

.ff-1 {
    top: 30%;
    left: 20%;
    animation: buzz 3s ease-in-out infinite alternate;
}

.ff-2 {
    top: 80%;
    left: 60%;
    animation: buzz 4s ease-in-out 1s infinite alternate;
}

.ff-3 {
    top: 50%;
    left: 90%;
    animation: buzz 2.5s ease-in-out 0.5s infinite alternate;
}

.chibi-dryad {
    position: absolute;
    inset: 0;
    animation: breathe 3s infinite alternate;
    transition: transform 0.1s ease-out;
}

.hair-back {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 120px;
    background: linear-gradient(180deg, #2d5a27, #1a3b16);
    border-radius: 45px 45px 20px 20px;
    z-index: 1;
    box-shadow: inset 0 -10px 20px rgba(0,0,0,0.5);
}

.body-dress {
    position: absolute;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 60px;
    z-index: 2;
}

.dress-layer {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(180deg, #52b788, #2d6a4f);
    border-radius: 10px 10px 50% 50%;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

.layer-1 {
    width: 50px;
    height: 45px;
    z-index: 1;
}

.layer-2 {
    width: 40px;
    height: 30px;
    z-index: 2;
    background: linear-gradient(180deg, #74c69d, #40916c);
}

.arm {
    position: absolute;
    top: 10px;
    width: 12px;
    height: 30px;
    background: #ffdfd3;
    border-radius: 10px;
    z-index: 3;
}

.arm-left {
    left: 5px;
    transform: rotate(15deg);
}

.arm-right {
    right: 5px;
    transform: rotate(-15deg);
}

.head {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 75px;
    background: #ffdfd3;
    border-radius: 50%;
    z-index: 4;
    box-shadow: inset -5px -5px 15px rgba(0,0,0,0.1);
}

.face {
    position: absolute;
    inset: 0;
}

.eye {
    position: absolute;
    top: 35px;
    width: 14px;
    height: 18px;
    background: #1a3b16;
    border-radius: 50%;
    overflow: hidden;
    animation: blink 4s infinite;
}

.eye-left {
    left: 15px;
}

.eye-right {
    right: 15px;
}

.pupil {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 10px;
    background: #7bed9f;
    border-radius: 50%;
    box-shadow: 0 0 5px #7bed9f;
    transition: transform 0.1s ease-out;
}

.highlight {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 4px;
    height: 4px;
    background: white;
    border-radius: 50%;
}

.blush {
    position: absolute;
    top: 50px;
    width: 12px;
    height: 6px;
    background: rgba(255, 100, 100, 0.4);
    border-radius: 50%;
    filter: blur(2px);
}

.blush-left {
    left: 8px;
}

.blush-right {
    right: 8px;
}

.mouth {
    position: absolute;
    bottom: 15px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 4px;
    border-bottom: 2px solid #a05a5a;
    border-radius: 50%;
}

.bangs {
    position: absolute;
    top: -5px;
    left: 50%;
    transform: translateX(-50%);
    width: 85px;
    height: 35px;
    background: linear-gradient(180deg, #3a7a33, #2d5a27);
    border-radius: 40px 40px 10px 10px;
    z-index: 5;
    clip-path: polygon(0% 0%, 100% 0%, 100% 80%, 85% 100%, 70% 70%, 50% 100%, 30% 70%, 15% 100%, 0% 80%);
}

.wreath {
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%) rotate(-10deg);
    width: 90px;
    height: 90px;
    border: 4px solid #52b788;
    border-radius: 50%;
    border-bottom-color: transparent;
    border-left-color: transparent;
    z-index: 6;
    box-shadow: 0 0 10px rgba(82, 183, 136, 0.5);
}

    .wreath::after {
        content: "🌿";
        position: absolute;
        top: -10px;
        left: 10px;
        font-size: 14px;
        transform: rotate(20deg);
    }

/* UI подарка */
.fairy-gift-ui {
    position: absolute;
    top: 160px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(20, 40, 25, 0.85);
    border: 1px solid var(--gold);
    border-radius: 20px;
    padding: 5px 15px;
    color: var(--gold);
    font-size: 0.8rem;
    font-weight: bold;
    white-space: nowrap;
    box-shadow: 0 0 10px rgba(245, 217, 154, 0.3);
    transition: all 0.3s ease;
    cursor: pointer;
}

    .fairy-gift-ui:hover {
        background: rgba(30, 60, 40, 0.95);
        box-shadow: 0 0 20px rgba(245, 217, 154, 0.6);
    }

    .fairy-gift-ui.ready {
        animation: pulseGold 1.5s infinite;
    }

/* Облачко с текстом дриады */
.fairy-comment-bubble {
    position: fixed;
    background: rgba(240, 235, 220, 0.95);
    color: #2d5a27;
    padding: 10px 15px;
    border-radius: 15px;
    border-bottom-left-radius: 2px;
    font-size: 0.85rem;
    font-weight: 600;
    max-width: 250px;
    z-index: 1000;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    animation: bubblePop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    pointer-events: none;
}

@keyframes bubblePop {
    from {
        opacity: 0;
        transform: scale(0.8) translateY(10px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.chibi-dryad.excited {
    animation: jumpExcitement 0.5s infinite alternate !important;
}

.fairy-mascot.flying-to-center {
    animation: flyToCenter 2s ease-in-out forwards !important;
}

@keyframes pulseGold {
    0% {
        box-shadow: 0 0 10px rgba(245, 217, 154, 0.4);
    }

    50% {
        box-shadow: 0 0 25px rgba(245, 217, 154, 0.9);
        color: #fff;
    }

    100% {
        box-shadow: 0 0 10px rgba(245, 217, 154, 0.4);
    }
}

@keyframes jumpExcitement {
    0% {
        transform: translateY(0) scale(1);
    }

    100% {
        transform: translateY(-30px) scale(1.1);
    }
}

@keyframes flyToCenter {
    0% {
        left: 5%;
        bottom: 10%;
        transform: scale(1);
    }

    50% {
        left: 50%;
        bottom: 40%;
        transform: scale(1.5);
    }

    100% {
        left: 50%;
        bottom: 30%;
        transform: scale(1.2);
    }
}

@keyframes floatDryad {
    0%, 100% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-20px) rotate(2deg);
    }
}

@keyframes breathe {
    0% {
        transform: scaleY(1);
    }

    100% {
        transform: scaleY(1.03);
    }
}

@keyframes pulseGlow {
    0% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.6;
    }

    100% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 1;
    }
}

@keyframes blink {
    0%, 96%, 100% {
        transform: scaleY(1);
    }

    98% {
        transform: scaleY(0.1);
    }
}

@keyframes flyLeaf {
    0% {
        transform: translate(0, 0) rotate(0deg);
        opacity: 0;
    }

    10% {
        opacity: 1;
    }

    90% {
        opacity: 1;
    }

    100% {
        transform: translate(50px, -100px) rotate(360deg);
        opacity: 0;
    }
}

@keyframes buzz {
    0% {
        transform: translate(0, 0);
        opacity: 0.3;
    }

    50% {
        opacity: 1;
    }

    100% {
        transform: translate(15px, -15px);
        opacity: 0.3;
    }
}

/* =========================================
   ДЕКОРАЦИИ ЛЕСА (ЛОЗЫ И КОРНИ)
   ========================================= */

.forest-decorations {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    mix-blend-mode: screen;
}

.root {
    position: absolute;
    bottom: -50px;
    width: 300px;
    height: 400px;
    background: radial-gradient(ellipse at bottom, rgba(45, 90, 39, 0.6) 0%, transparent 70%);
    filter: blur(15px);
    border-radius: 50%;
}

.root-left {
    left: -100px;
}

.root-right {
    right: -100px;
}

.vine {
    position: absolute;
    top: -20px;
    width: 400px;
    height: 100vh;
    background-image: url("data:image/svg+xml,%3Csvg width='400' height='800' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M 0 0 C 50 150, 300 250, 200 500 C 100 750, 350 850, 300 1000' fill='none' stroke='%237bed9f' stroke-width='8' stroke-linecap='round'/%3E%3Cpath d='M 50 100 C 100 200, 250 300, 150 600' fill='none' stroke='%23a5edbf' stroke-width='4' stroke-linecap='round' opacity='0.8'/%3E%3C/svg%3E");
    background-size: cover;
    opacity: 1;
    filter: drop-shadow(0 0 10px #7bed9f);
}

.vine-left {
    left: -100px;
    transform: scaleX(-1);
}

.vine-right {
    right: -100px;
}

.leaf-decor {
    position: absolute;
    background: linear-gradient(135deg, #7bed9f, #2d5a27);
    border-radius: 0 50% 0 50%;
    box-shadow: 0 0 15px rgba(123, 237, 159, 0.4);
    opacity: 0.7;
    animation: swing 4s ease-in-out infinite alternate;
}

.l-1 {
    top: 10%;
    left: 2%;
    width: 25px;
    height: 25px;
    animation-delay: 0s;
    transform: rotate(45deg);
}

.l-2 {
    top: 30%;
    left: 8%;
    width: 15px;
    height: 15px;
    animation-delay: 1s;
    transform: rotate(-30deg);
}

.l-3 {
    top: 15%;
    right: 3%;
    width: 20px;
    height: 20px;
    animation-delay: 0.5s;
    transform: rotate(60deg);
}

.l-4 {
    top: 40%;
    right: 10%;
    width: 30px;
    height: 30px;
    animation-delay: 1.5s;
    transform: rotate(-10deg);
}

.forest-decorations::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 150px rgba(45, 90, 39, 0.3);
}

@keyframes swing {
    0% {
        transform: rotate(45deg) scale(1);
    }

    100% {
        transform: rotate(55deg) scale(1.1);
    }
}

@media (max-width: 760px) {
    .vine {
        width: 200px;
        opacity: 0.4;
    }

    .vine-left {
        left: -80px;
    }

    .vine-right {
        right: -80px;
    }

    .root {
        width: 200px;
        height: 200px;
        opacity: 0.5;
    }

    .leaf-decor {
        display: none;
    }
}
