# АВТОРИЗАЦИЯ
# ============================================================

class Authorization:

    def __init__(self, database):
        self.db = database

    @staticmethod
    def hash_password(password, salt):
        """
        Хеширование пароля.
        Используется SHA-256, как в исходной базе.
        """

        return hashlib.sha256(
            (password + salt).encode("utf-8")
        ).hexdigest()

    def login(self):
        """Авторизация пользователя."""

        header("ВХОД В СИСТЕМУ")

        login = input("  Логин: ").strip()
        password = input("  Пароль: ")

        if not login or not password:
            message("✗ Заполните все поля.")
            return False

        # Получаем данные пользователя
        user = self.db.select(
            """
            SELECT
                UserID,
                PasswordHash,
                Salt,
                FullName,
                IsActive
            FROM Users
            WHERE Login = ?
            """,
            (login,)
        )

        # Пользователь не найден
        if user is None:
            self.log_attempt(login, False)

            message("✗ Неверный логин или пароль.")
            return False

        user_id, stored_hash, salt, full_name, is_active = user

        # Проверка блокировки
        if not is_active:
            self.log_attempt(login, False)

            message("✗ Данный аккаунт заблокирован.")
            return False

        # Проверка пароля
        entered_hash = self.hash_password(
            password,
            salt
        )

        if not hmac.compare_digest(
            entered_hash,
            stored_hash
        ):
            self.log_attempt(login, False)

            message("✗ Неверный логин или пароль.")
            return False

        # Обновляем дату последнего входа
        self.db.execute(
            """
            UPDATE Users
            SET LastLoginDate = ?
            WHERE UserID = ?
            """,
            (
                datetime.now(),
                user_id
            )
        )

        # Записываем успешный вход
        self.log_attempt(login, True)

        name = full_name or login

        header("УСПЕШНАЯ АВТОРИЗАЦИЯ")

        print()
        print(f"  Добро пожаловать, {name}!")
        print()
        print("  ✓ Вы успешно вошли в систему.")

        return True

    def log_attempt(self, login, success):
        """Запись попытки авторизации."""

        self.db.execute(
            """
            INSERT INTO LoginAttempts
                (Login, Success, IPAddress)
            VALUES
                (?, ?, ?)
            """,
            (
                login,
                1 if success else 0,
                "localhost"
            )
        )


