
import os
import sys
import subprocess

project_folder = os.path.join(
    os.path.expanduser("~"),
    "Documents",
    "Depix"
)

depix_file = os.path.join(project_folder, "depix.py")

if not os.path.isfile(depix_file):
    print("Не найден файл:", depix_file)
    print("Проверь папку, куда распаковал Depix.")
else:
    result = subprocess.run(
        [
            sys.executable,
            "-m",
            "pip",
            "install",
            "-r",
            os.path.join(project_folder, "requirements.txt")
        ],
        capture_output=True,
        text=True
    )

    print(result.stdout)
    print(result.stderr)

    if result.returncode == 0:
        print("Зависимости Depix установлены.")
    else:
        print("Ошибка установки. Скопируй текст ошибки.")
