class AuthSystem:
    """Система регистрации и авторизации."""

    def __init__(self, database):
        self.db = database

    # --------------------------------------------------------
    # ХЕШИРОВАНИЕ
    # --------------------------------------------------------

    @staticmethod
    def hash_password(password):
        """
        Новое безопасное хеширование пароля.

        Используется PBKDF2-HMAC-SHA256.
        Дополнительные библиотеки не нужны.
        """

        salt = secrets.token_bytes(SALT_LENGTH)

        password_hash = hashlib.pbkdf2_hmac(
            "sha256",
            password.encode("utf-8"),
            salt,
            PBKDF2_ITERATIONS
        )

        return password_hash.hex(), salt.hex()

    @staticmethod
    def hash_password_old(password, salt):
        """
        Старый способ хеширования из исходной программы.

        Нужен для совместимости с уже существующими
        пользователями.
        """

        value = password + salt

        return hashlib.sha256(
            value.encode("utf-8")
        ).hexdigest()

    @staticmethod
    def verify_password(password, stored_hash, salt):
        """
        Проверяет пароль.

        Поддерживает:
        1. новый PBKDF2
        2. старый SHA-256
        """

        # ----------------------------------------------------
        # Попытка проверить новый PBKDF2
        # ----------------------------------------------------

        try:
            salt_bytes = bytes.fromhex(salt)

            new_hash = hashlib.pbkdf2_hmac(
                "sha256",
                password.encode("utf-8"),
                salt_bytes,
                PBKDF2_ITERATIONS
            ).hex()

            if hmac.compare_digest(new_hash, stored_hash):
                return True, "pbkdf2"

        except (ValueError, TypeError):
            pass

        # ----------------------------------------------------
        # Проверка старого SHA-256
        # ----------------------------------------------------

        old_hash = AuthSystem.hash_password_old(
            password,
            salt
        )

        if hmac.compare_digest(old_hash, stored_hash):
            return True, "sha256"

        return False, None

    # --------------------------------------------------------
    # РЕГИСТРАЦИЯ
    # --------------------------------------------------------

    def register(self):
        """Регистрация нового пользователя."""

        print_header("РЕГИСТРАЦИЯ НОВОГО ПОЛЬЗОВАТЕЛЯ")

        # Логин
        while True:
            login = input("Придумайте логин: ").strip()

            if not login:
                print("✗ Логин не может быть пустым.")
                continue

            if not validate_login(login):
                print(
                    "✗ Логин может содержать только "
                    "латинские буквы, цифры, _, - и ."
                )
                continue

            if len(login) > 50:
                print("✗ Логин слишком длинный.")
                continue

            break

        # Проверяем существование
        result = self.db.select(
            """
            SELECT UserID
            FROM Users
            WHERE Login = ?
            """,
            (login,)
        )

        if result is None:
            print("✗ Не удалось проверить логин.")
            return False

        if result:
            print()
            print(
                f"✗ Пользователь '{login}' "
                f"уже существует."
            )
            return False

        # Пароль
        while True:
            password = input(
                "Придумайте пароль (мин. 4 символа): "
            )

            if len(password) < 4:
                print("✗ Пароль слишком короткий.")
                continue

            break

        # Подтверждение
        while True:
            password_confirm = input(
                "Повторите пароль: "
            )

            if password != password_confirm:
                print("✗ Пароли не совпадают.")
                continue

            break

        # Имя
        full_name = input(
            "Введите полное имя (Enter - пропустить): "
        ).strip()

        # Email
        while True:
            email = input(
                "Введите email (Enter - пропустить): "
            ).strip()

            if validate_email(email):
                break

            print("✗ Некорректный email.")

        # Хеш
        password_hash, salt = self.hash_password(
            password
        )

        # Запись в БД
        success = self.db.execute(
            """
            INSERT INTO Users
                (Login, PasswordHash, Salt, FullName, Email)
            VALUES
                (?, ?, ?, ?, ?)
            """,
            (
                login,
                password_hash,
                salt,
                full_name or None,
                email or None
            )
        )

        if not success:
            print()
            print("✗ Не удалось зарегистрировать пользователя.")
            return False

        print()
        print("✓ Регистрация успешно завершена!")
        print()
        print("Логин:", login)

        if full_name:
            print("Имя:", full_name)

        return True

    # --------------------------------------------------------
    # ВХОД
    # --------------------------------------------------------

    def login(self):
        """Авторизация пользователя."""

        print_header("ВХОД В СИСТЕМУ")

        login = input("Введите логин: ").strip()
        password = input("Введите пароль: ")

        result = self.db.select(
            """
            SELECT
                UserID,
                PasswordHash,
                Salt,
                FullName,
                IsActive
            FROM Users
            WHERE Login = ?
            """,
            (login,)
        )

        # Пользователь не найден
        if result is None:
            return False

        if not result:
            self.log_attempt(login, False)

            print()
            print("✗ Неверный логин или пароль.")
            return False

        (
            user_id,
            stored_hash,
            salt,
            full_name,
            is_active
        ) = result[0]

        # Заблокирован
        if not is_active:
            print()
            print("✗ Аккаунт заблокирован.")
            return False

        # Проверяем пароль
        correct, hash_type = self.verify_password(
            password,
            stored_hash,
            salt
        )

        if not correct:
            self.log_attempt(login, False)

            print()
            print("✗ Неверный логин или пароль.")
            return False

        # ----------------------------------------------------
        # Если старый SHA-256 успешно проверился,
        # автоматически обновляем хеш до PBKDF2.
        # ----------------------------------------------------

        if hash_type == "sha256":
            new_hash, new_salt = self.hash_password(
                password
            )

            self.db.execute(
                """
                UPDATE Users
                SET PasswordHash = ?, Salt = ?
                WHERE UserID = ?
                """,
                (
                    new_hash,
                    new_salt,
                    user_id
                )
            )

        # Обновляем дату последнего входа
        self.db.execute(
            """
            UPDATE Users
            SET LastLoginDate = ?
            WHERE UserID = ?
            """,
            (
                datetime.now(),
                user_id
            )
        )

        # Логируем успешный вход
        self.log_attempt(login, True)

        display_name = full_name or login

        print()
        print("✓ Авторизация успешна!")
        print()
        print(
            f"Добро пожаловать, {display_name}!"
        )

        return True

    # --------------------------------------------------------
    # ЛОГИРОВАНИЕ
    # --------------------------------------------------------

    def log_attempt(self, login, success):
        """Записывает попытку входа."""

        self.db.execute(
            """
            INSERT INTO LoginAttempts
                (Login, Success, IPAddress)
            VALUES
                (?, ?, ?)
            """,
            (
                login,
                1 if success else 0,
                "localhost"
            )
        )

    # --------------------------------------------------------
    # СМЕНА ПАРОЛЯ
    # --------------------------------------------------------

    def change_password(self):
        """Изменение пароля."""

        print_header("СМЕНА ПАРОЛЯ")

        login = input("Введите логин: ").strip()
        old_password = input("Введите старый пароль: ")

        result = self.db.select(
            """
            SELECT UserID, PasswordHash, Salt
            FROM Users
            WHERE Login = ?
            """,
            (login,)
        )

        if result is None:
            return False

        if not result:
            print()
            print("✗ Пользователь не найден.")
            return False

        user_id, stored_hash, salt = result[0]

        correct, _ = self.verify_password(
            old_password,
            stored_hash,
            salt
        )

        if not correct:
            print()
            print("✗ Старый пароль неверен.")
            return False

        # Новый пароль
        while True:
            new_password = input(
                "Введите новый пароль (мин. 4 символа): "
            )

            if len(new_password) < 4:
                print("✗ Пароль слишком короткий.")
                continue

            break

        # Подтверждение
        while True:
            confirm = input(
                "Повторите новый пароль: "
            )

            if confirm != new_password:
                print("✗ Пароли не совпадают.")
                continue

            break

        new_hash, new_salt = self.hash_password(
            new_password
        )

        success = self.db.execute(
            """
            UPDATE Users
            SET PasswordHash = ?, Salt = ?
            WHERE UserID = ?
            """,
            (
                new_hash,
                new_salt,
                user_id
            )
        )

        if success:
            print()
            print("✓ Пароль успешно изменён.")

        return success

