const SYMBOLS = ["🍒", "🍋", "🍊", "🔔", "⭐", "💎"];

const state = {
  slotBet: 10,
  rouletteBet: 10,
  rouletteType: "red",
  busy: false,
  wheelAngle: 0,
};

const balanceEl = document.getElementById("balance");
const balanceBox = document.getElementById("balanceBox");

/* ================= БАЛАНС ================= */
function setBalance(value) {
  balanceEl.textContent = value;
  balanceEl.classList.remove("pop");
  void balanceEl.offsetWidth;
  balanceEl.classList.add("pop");

  balanceBox.classList.remove("flash");
  void balanceBox.offsetWidth;
  balanceBox.classList.add("flash");
}

function showMessage(id, text, cls) {
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = "message" + (cls ? " " + cls : "");
}

async function api(path, body) {
  const res = await fetch(path, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body || {}),
  });
  return res.json();
}

/* ================= КОНФЕТТИ ================= */
const canvas = document.getElementById("confettiCanvas");
const ctx = canvas.getContext("2d");
let particles = [];
let confettiRunning = false;

function resizeCanvas() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resizeCanvas();
window.addEventListener("resize", resizeCanvas);

const COLORS = ["#ffd93b", "#f5a623", "#4ade80", "#4dabf7", "#cc5de8", "#ff6b6b", "#ffffff"];

function launchConfetti(count = 150) {
  for (let i = 0; i < count; i++) {
    particles.push({
      x: canvas.width / 2 + (Math.random() - 0.5) * 200,
      y: canvas.height / 2 + (Math.random() - 0.5) * 100,
      vx: (Math.random() - 0.5) * 14,
      vy: -Math.random() * 14 - 4,
      size: Math.random() * 8 + 4,
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      rot: Math.random() * Math.PI * 2,
      vrot: (Math.random() - 0.5) * 0.3,
      life: 1,
      shape: Math.random() < 0.4 ? "circle" : "rect",
    });
  }
  if (!confettiRunning) {
    confettiRunning = true;
    requestAnimationFrame(confettiLoop);
  }
}

function confettiLoop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  particles = particles.filter((p) => p.life > 0);
  particles.forEach((p) => {
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.35;
    p.vx *= 0.99;
    p.rot += p.vrot;
    p.life -= 0.008;

    ctx.save();
    ctx.globalAlpha = Math.max(p.life, 0);
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rot);
    ctx.fillStyle = p.color;
    if (p.shape === "circle") {
      ctx.beginPath();
      ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
      ctx.fill();
    } else {
      ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
    }
    ctx.restore();
  });

  if (particles.length > 0) {
    requestAnimationFrame(confettiLoop);
  } else {
    confettiRunning = false;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
}

/* ================= МОНЕТКА, ЛЕТЯЩАЯ К БАЛАНСУ ================= */
function flyCoin(fromX, fromY) {
  const coin = document.createElement("div");
  coin.className = "fly-coin";
  coin.textContent = "🪙";
  coin.style.left = fromX + "px";
  coin.style.top = fromY + "px";
  document.body.appendChild(coin);

  const target = balanceBox.getBoundingClientRect();
  const tx = target.left + target.width / 2 - 12;
  const ty = target.top + target.height / 2 - 12;

  requestAnimationFrame(() => {
    coin.style.transform = `translate(${tx - fromX}px, ${ty - fromY}px) scale(1.6) rotate(720deg)`;
  });

  setTimeout(() => {
    coin.style.opacity = "0";
    setTimeout(() => coin.remove(), 300);
  }, 850);
}

/* ================= BIG WIN ================= */
function bigWin(amount) {
  const ov = document.getElementById("bigWinOverlay");
  const amt = document.getElementById("bigWinAmount");
  amt.textContent = "+" + amount + " 🪙";
  ov.classList.add("show");
  setTimeout(() => ov.classList.remove("show"), 1600);
}

/* ================= ТАБЫ ================= */
document.querySelectorAll(".tab").forEach((tab) => {
  tab.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach((t) => t.classList.remove("active"));
    document.querySelectorAll(".panel").forEach((p) => p.classList.remove("active"));
    tab.classList.add("active");
    document.getElementById("tab-" + tab.dataset.tab).classList.add("active");
  });
});

/* ================= ВЫБОР ФИШКИ ================= */
document.querySelectorAll(".chip").forEach((chip) => {
  chip.addEventListener("click", () => {
    const panel = chip.closest(".panel");
    panel.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
    chip.classList.add("active");

    const val = parseInt(chip.dataset.bet, 10);
    if (panel.id === "tab-slots") {
      state.slotBet = val;
      document.getElementById("slotBet").textContent = val;
    } else {
      state.rouletteBet = val;
      document.getElementById("rouletteBet").textContent = val;
    }
  });
});

/* ================= ТИП СТАВКИ ================= */
document.querySelectorAll(".bet-btn").forEach((btn) => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".bet-btn").forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    state.rouletteType = btn.dataset.bet;
  });
});

/* ================= СБРОС ================= */
document.getElementById("resetBtn").addEventListener("click", async () => {
  const data = await api("/api/reset");
  setBalance(data.balance);
  showMessage("slotMessage", "Баланс сброшен. Удачи!", "win");
  showMessage("rouletteMessage", "Баланс сброшен. Удачи!", "win");
});

/* ================= СЛОТЫ: СПИН ================= */
document.getElementById("spinBtn").addEventListener("click", async () => {
  if (state.busy) return;
  state.busy = true;
  const btn = document.getElementById("spinBtn");
  btn.disabled = true;

  let data;
  try {
    data = await api("/api/spin", { bet: state.slotBet });
  } catch (e) {
    showMessage("slotMessage", "Ошибка сети", "lose");
    state.busy = false; btn.disabled = false; return;
  }

  if (data.error) {
    showMessage("slotMessage", data.error, "lose");
    state.busy = false; btn.disabled = false; return;
  }

  const reels = ["reel1", "reel2", "reel3"].map((id) => document.getElementById(id));
  const wraps = reels.map((r) => r.parentElement);
  wraps.forEach((w) => w.classList.remove("win-glow"));
  reels.forEach((r) => r.classList.add("spinning"));

  const interval = setInterval(() => {
    reels.forEach((r) => (r.textContent = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)]));
  }, 70);

  setTimeout(() => {
    clearInterval(interval);
    reels.forEach((r, i) => {
      r.classList.remove("spinning");
      r.textContent = data.reels[i];
    });
    setBalance(data.balance);

    if (data.multiplier > 0) {
      showMessage("slotMessage", data.message, "win");

      reels.forEach((r, i) => {
        setTimeout(() => {
          wraps[i].classList.add("win-glow");
          r.classList.add("win");
          setTimeout(() => r.classList.remove("win"), 1500);
        }, i * 120);
      });

      // Монетки летят от каждого барабана
      wraps.forEach((w, i) => {
        const rect = w.getBoundingClientRect();
        setTimeout(() => flyCoin(rect.left + rect.width / 2, rect.top + rect.height / 2), i * 120);
      });

      // Конфетти
      if (data.multiplier >= 15) {
        launchConfetti(220);
        bigWin(data.winnings);
      } else {
        launchConfetti(90);
      }
    } else {
      showMessage("slotMessage", data.message, "lose");
    }

    state.busy = false;
    btn.disabled = false;
  }, 1300);
});

/* ================= РУЛЕТКА: СПИН ================= */
document.getElementById("rouletteBtn").addEventListener("click", async () => {
  if (state.busy) return;
  state.busy = true;
  const btn = document.getElementById("rouletteBtn");
  btn.disabled = true;

  const body = { bet: state.rouletteBet, type: state.rouletteType };

  if (state.rouletteType === "number") {
    const val = document.getElementById("numberBet").value;
    if (val === "") {
      showMessage("rouletteMessage", "Введите число от 0 до 36", "lose");
      state.busy = false; btn.disabled = false; return;
    }
    body.value = val;
  }

  let data;
  try {
    data = await api("/api/roulette", body);
  } catch (e) {
    showMessage("rouletteMessage", "Ошибка сети", "lose");
    state.busy = false; btn.disabled = false; return;
  }

  if (data.error) {
    showMessage("rouletteMessage", data.error, "lose");
    state.busy = false; btn.disabled = false; return;
  }

  const wheel = document.getElementById("wheel");
  const center = document.getElementById("wheelResult");
  center.textContent = "?";
  center.className = "wheel-center";

  // Угол сектора: 0 = зелёный (0), остальные по 10°, кроме зелёного (тоже 10°)
  // 37 секторов, но у нас 36 красных/чёрных по 10° и 1 зелёный 10° ≈ 360°/37 ≈ 9.73°
  // Для простоты: 360/37 ≈ 9.73°, сектор = номер * 360/37
  const sectorAngle = 360 / 37;
  const targetAngle = -data.number * sectorAngle;

  // Крутим на несколько полных оборотов вперёд
  const turns = 6;
  state.wheelAngle += 360 * turns + (targetAngle - (state.wheelAngle % 360));
  wheel.style.transform = `rotate(${state.wheelAngle}deg)`;

  // Ждём окончания CSS-анимации (4 секунды)
  setTimeout(() => {
    center.textContent = data.number;
    center.classList.add(data.color);
    setBalance(data.balance);
    showMessage("rouletteMessage", data.message, data.win ? "win" : "lose");

    if (data.win) {
      const rect = wheel.getBoundingClientRect();
      flyCoin(rect.left + rect.width / 2, rect.top + rect.height / 2);

      if (data.winnings >= 500) {
        launchConfetti(250);
        bigWin(data.winnings);
      } else {
        launchConfetti(100);
      }
    }

    state.busy = false;
    btn.disabled = false;
  }, 4100);
});

/* ================= СТАРТ ================= */
fetch("/api/balance")
  .then((r) => r.json())
  .then((d) => setBalance(d.balance));