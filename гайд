import os

folder = r"D:\ЗАГРУЗКИ\Depix"

for root, dirs, files in os.walk(folder):
    level = root.replace(folder, "").count(os.sep)

    if level > 3:
        dirs[:] = []
        continue

    print("\n" + "    " * level + os.path.basename(root))

    for filename in files:
        print("    " * (level + 1) + filename)