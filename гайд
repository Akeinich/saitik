USE [IP_33_06];
GO

-- 1. Справочник ролей
IF OBJECT_ID('dbo.SDL_Roles', 'U') IS NULL
CREATE TABLE dbo.SDL_Roles (
    RoleID INT IDENTITY(1,1) PRIMARY KEY,
    RoleName NVARCHAR(50) NOT NULL UNIQUE
);

-- 2. Пользователи системы
IF OBJECT_ID('dbo.SDL_Users', 'U') IS NULL
CREATE TABLE dbo.SDL_Users (
    UserID INT IDENTITY(1,1) PRIMARY KEY,
    FullName NVARCHAR(150) NOT NULL,
    Email NVARCHAR(100) NOT NULL UNIQUE,
    PasswordHash NVARCHAR(256) NOT NULL,
    Department NVARCHAR(100) NULL,
    RoleID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Roles(RoleID),
    IsActive BIT NOT NULL DEFAULT 1,
    CreatedAt DATETIME NOT NULL DEFAULT GETDATE()
);

-- 3. Справочник категорий заявок
IF OBJECT_ID('dbo.SDL_Categories', 'U') IS NULL
CREATE TABLE dbo.SDL_Categories (
    CategoryID INT IDENTITY(1,1) PRIMARY KEY,
    CategoryName NVARCHAR(100) NOT NULL UNIQUE,
    DefaultExecutorID INT NULL FOREIGN KEY REFERENCES dbo.SDL_Users(UserID)
);

-- 4. Справочник приоритетов и SLA (в часах)
IF OBJECT_ID('dbo.SDL_Priorities', 'U') IS NULL
CREATE TABLE dbo.SDL_Priorities (
    PriorityID INT IDENTITY(1,1) PRIMARY KEY,
    PriorityName NVARCHAR(50) NOT NULL UNIQUE,
    SLA_Hours INT NOT NULL DEFAULT 24
);

-- 5. Справочник статусов
IF OBJECT_ID('dbo.SDL_Statuses', 'U') IS NULL
CREATE TABLE dbo.SDL_Statuses (
    StatusID INT IDENTITY(1,1) PRIMARY KEY,
    StatusName NVARCHAR(50) NOT NULL UNIQUE
);

-- 6. Заявки (тикеты)
IF OBJECT_ID('dbo.SDL_Tickets', 'U') IS NULL
CREATE TABLE dbo.SDL_Tickets (
    TicketID INT IDENTITY(1001,1) PRIMARY KEY,
    Subject NVARCHAR(200) NOT NULL,
    Description NVARCHAR(MAX) NOT NULL,
    CategoryID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Categories(CategoryID),
    PriorityID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Priorities(PriorityID),
    StatusID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Statuses(StatusID),
    AuthorID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Users(UserID),
    ExecutorID INT NULL FOREIGN KEY REFERENCES dbo.SDL_Users(UserID),
    CreatedAt DATETIME NOT NULL DEFAULT GETDATE(),
    UpdatedAt DATETIME NOT NULL DEFAULT GETDATE(),
    ClosedAt DATETIME NULL
);

-- 7. Комментарии к заявкам
IF OBJECT_ID('dbo.SDL_Comments', 'U') IS NULL
CREATE TABLE dbo.SDL_Comments (
    CommentID INT IDENTITY(1,1) PRIMARY KEY,
    TicketID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Tickets(TicketID),
    AuthorID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Users(UserID),
    CommentText NVARCHAR(MAX) NOT NULL,
    CreatedAt DATETIME NOT NULL DEFAULT GETDATE()
);

-- 8. Вложения (файлы)
IF OBJECT_ID('dbo.SDL_Attachments', 'U') IS NULL
CREATE TABLE dbo.SDL_Attachments (
    AttachmentID INT IDENTITY(1,1) PRIMARY KEY,
    TicketID INT NOT NULL FOREIGN KEY REFERENCES dbo.SDL_Tickets(TicketID),
    FileName NVARCHAR(255) NOT NULL,
    FileData VARBINARY(MAX) NULL,
    UploadedAt DATETIME NOT NULL DEFAULT GETDATE()
);
