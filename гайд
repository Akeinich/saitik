/* ================= СЛОТЫ: СПИН ================= */
document.getElementById("spinBtn").addEventListener("click", async () => {
  if (state.busy) return;
  state.busy = true;
  const btn = document.getElementById("spinBtn");
  btn.disabled = true;

  let data;
  try {
    data = await api("/api/spin", { bet: state.slotBet });
  } catch (e) {
    showMessage("slotMessage", "Ошибка сети", "lose");
    state.busy = false; btn.disabled = false; return;
  }

  if (data.error) {
    showMessage("slotMessage", data.error, "lose");
    state.busy = false; btn.disabled = false; return;
  }

  const reels = ["reel1", "reel2", "reel3"].map((id) => document.getElementById(id));
  const wraps = reels.map((r) => r.parentElement);
  wraps.forEach((w) => w.classList.remove("win-glow"));
  reels.forEach((r) => r.classList.remove("win"));

  showMessage("slotMessage", "Крутим...", "");

  // Поочерёдная остановка: 1-й → 2-й → 3-й
  // 700мс, 1500мс, 2400мс — паузы растут, интрига нарастает
  const stopDurations = [700, 1500, 2400];

  // Запускаем все барабаны параллельно, но с разной длительностью
  const spinPromises = reels.map((reel, i) =>
    spinReel(reel, stopDurations[i], data.reels[i])
  );

  // Интрига: если первые два совпали — показываем подсказку, пока 3-й крутится
  setTimeout(() => {
    if (data.reels[0] === data.reels[1]) {
      showMessage("slotMessage", "Возможен выигрыш! 🎯", "win");
    }
  }, stopDurations[1] + 80);

  // Ждём, пока все три барабана остановятся
  await Promise.all(spinPromises);

  setBalance(data.balance);

  if (data.multiplier > 0) {
    showMessage("slotMessage", data.message, "win");

    reels.forEach((r, i) => {
      setTimeout(() => {
        wraps[i].classList.add("win-glow");
        r.classList.add("win");
        setTimeout(() => r.classList.remove("win"), 1500);
      }, i * 120);
    });

    wraps.forEach((w, i) => {
      const rect = w.getBoundingClientRect();
      setTimeout(() => flyCoin(rect.left + rect.width / 2, rect.top + rect.height / 2), i * 120);
    });

    if (data.multiplier >= 15) {
      launchConfetti(220);
      bigWin(data.winnings);
    } else {
      launchConfetti(90);
    }
  } else {
    showMessage("slotMessage", data.message, "lose");
  }

  state.busy = false;
  btn.disabled = false;
});

/* Прокрутка одного барабана с плавным замедлением */
function spinReel(reelEl, duration, finalSymbol) {
  return new Promise((resolve) => {
    reelEl.classList.add("spinning");
    const start = performance.now();
    let lastUpdate = 0;

    function tick(now) {
      const elapsed = now - start;

      if (elapsed >= duration) {
        // Останавливаемся: убираем «кручение», ставим финальный символ,
        // включаем анимацию отскока
        reelEl.classList.remove("spinning");
        reelEl.textContent = finalSymbol;
        reelEl.classList.add("landing");
        setTimeout(() => reelEl.classList.remove("landing"), 400);
        resolve();
        return;
      }

      // Замедление к концу: от 50мс до 250мс между сменами символов
      const progress = elapsed / duration;
      const delay = 50 + progress * progress * 200;

      if (now - lastUpdate >= delay) {
        reelEl.textContent = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
        lastUpdate = now;
      }

      requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  });
}