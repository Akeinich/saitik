def validate_login(login):
    """
    Простая проверка логина.
    Разрешаем латиницу, цифры, _, -, .
    """

    if not login:
        return False

    if len(login) > 50:
        return False

    allowed = (
        "abcdefghijklmnopqrstuvwxyz"
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        "0123456789_-."
    )

    return all(char in allowed for char in login)


def validate_email(email):
    """Простая проверка email."""

    if not email:
        return True

    if len(email) > 100:
        return False

    return "@" in email and "." in email


