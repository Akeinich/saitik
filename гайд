import os
import sys
import subprocess
import importlib.util

print("Python:", sys.version)
print("Путь к Python:", sys.executable)

packages = ["PIL", "numpy", "scipy", "cv2"]

for package in packages:
    print(
        package,
        "— установлен" if importlib.util.find_spec(package)
        else "— не установлен"
    )

print("\nПроверка pip:")
subprocess.run([
    sys.executable, "-m", "pip", "--version"
])