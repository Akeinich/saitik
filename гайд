class Database:
    """Класс для работы с SQL Server."""

    def __init__(self):
        self.connection = None
        self.cursor = None
        self.driver = None

    def find_driver(self):
        """
        Определяет установленный ODBC-драйвер.
        """

        drivers = pyodbc.drivers()

        if not drivers:
            return None

        # Предпочтительные драйверы.
        preferred = [
            "ODBC Driver 18 for SQL Server",
            "ODBC Driver 17 for SQL Server",
            "ODBC Driver 13 for SQL Server",
            "ODBC Driver 11 for SQL Server",
            "SQL Server Native Client 11.0",
            "SQL Server"
        ]

        for preferred_driver in preferred:
            if preferred_driver in drivers:
                return preferred_driver

        # Если ничего из известных нет,
        # берём последний установленный драйвер.
        return drivers[-1]

    def connect(self):
        """Подключение к SQL Server."""

        print_header("ПОДКЛЮЧЕНИЕ К БАЗЕ ДАННЫХ")

        print("Сервер:   ", SERVER)
        print("База:     ", DATABASE)
        print("Пользователь:", USERNAME)
        print()

        self.driver = self.find_driver()

        if not self.driver:
            print("✗ ODBC-драйвер SQL Server не найден.")
            print()
            print("Установленные драйверы отсутствуют.")
            return False

        print("Используется драйвер:")
        print(self.driver)
        print()

        connection_string = (
            f"DRIVER={{{self.driver}}};"
            f"SERVER={SERVER};"
            f"DATABASE={DATABASE};"
            f"UID={USERNAME};"
            f"PWD={PASSWORD};"
            "TrustServerCertificate=yes;"
        )

        try:
            self.connection = pyodbc.connect(
                connection_string,
                timeout=5
            )

            self.cursor = self.connection.cursor()

            print("✓ Подключение успешно!")
            return True

        except pyodbc.Error as error:
            print("✗ Не удалось подключиться к SQL Server.")
            print()
            print("Ошибка:")
            print(error)

            self.connection = None
            self.cursor = None

            return False

    def close(self):
        """Закрытие соединения."""

        try:
            if self.cursor:
                self.cursor.close()
        except pyodbc.Error:
            pass

        try:
            if self.connection:
                self.connection.close()
        except pyodbc.Error:
            pass

        self.cursor = None
        self.connection = None

    def select(self, query, params=()):
        """
        Выполнение SELECT-запроса.
        Возвращает список строк.
        """

        try:
            self.cursor.execute(query, params)
            return self.cursor.fetchall()

        except pyodbc.Error as error:
            print()
            print("✗ Ошибка SQL:")
            print(error)
            return None

    def execute(self, query, params=()):
        """
        Выполнение INSERT / UPDATE / DELETE.
        """

        try:
            self.cursor.execute(query, params)
            self.connection.commit()
            return True

        except pyodbc.Error as error:
            print()
            print("✗ Ошибка SQL:")
            print(error)

            try:
                self.connection.rollback()
            except pyodbc.Error:
                pass

            return False


