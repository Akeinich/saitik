# ============================================================

class Authorization:

    def __init__(self, database):
        self.db = database

    @staticmethod
    def hash_password(password, salt=None):
        """Создание хеша пароля."""

        if salt is None:
            salt = secrets.token_hex(16)

        password_hash = hashlib.sha256(
            (password + salt).encode("utf-8")
        ).hexdigest()

        return password_hash, salt

    # ========================================================
    # РЕГИСТРАЦИЯ
    # ========================================================

    def register(self):
        """Регистрация нового пользователя."""

        header("РЕГИСТРАЦИЯ")

        login = input("  Придумайте логин: ").strip()

        if not login:
            message("✗ Логин не может быть пустым.")
            return

        # Проверяем существование логина
        user = self.db.select_one(
            """
            SELECT UserID
            FROM Users
            WHERE Login = ?
            """,
            (login,)
        )

        if user:
            message("✗ Такой пользователь уже существует.")
            return

        password = input(
            "  Придумайте пароль (мин. 4 символа): "
        )

        if len(password) < 4:
            message("✗ Пароль должен содержать минимум 4 символа.")
            return

        password_confirm = input(
            "  Повторите пароль: "
        )

        if password != password_confirm:
            message("✗ Пароли не совпадают.")
            return

        full_name = input(
            "  Полное имя (Enter — пропустить): "
        ).strip()

        email = input(
            "  Email (Enter — пропустить): "
        ).strip()

        password_hash, salt = self.hash_password(password)

        success = self.db.execute(
            """
            INSERT INTO Users
                (Login, PasswordHash, Salt, FullName, Email)
            VALUES
                (?, ?, ?, ?, ?)
            """,
            (
                login,
                password_hash,
                salt,
                full_name or None,
                email or None
            )
        )

        if success:
            header("РЕГИСТРАЦИЯ ЗАВЕРШЕНА")

            print()
            print("  ✓ Пользователь успешно зарегистрирован.")
            print()
            print("  Логин:", login)

    # ========================================================
    # ВХОД
    # ========================================================

    def login(self):
        """Вход пользователя в систему."""

        header("ВХОД В СИСТЕМУ")

        login = input("  Логин: ").strip()
        password = input("  Пароль: ")

        if not login or not password:
            message("✗ Заполните все поля.")
            return

        user = self.db.select_one(
            """
            SELECT
                UserID,
                PasswordHash,
                Salt,
                FullName,
                IsActive
            FROM Users
            WHERE Login = ?
            """,
            (login,)
        )

        # Пользователь не найден
        if not user:
            self.log_attempt(login, False)

            message("✗ Неверный логин или пароль.")
            return

        (
            user_id,
            stored_hash,
            salt,
            full_name,
            is_active
        ) = user

        # Проверка блокировки
        if not is_active:
            message("✗ Данный аккаунт заблокирован.")
            return

        # Проверка пароля
        entered_hash, _ = self.hash_password(
            password,
            salt
        )

        if not hmac.compare_digest(
            entered_hash,
            stored_hash
        ):
            self.log_attempt(login, False)

            message("✗ Неверный логин или пароль.")
            return

        # Обновляем дату последнего входа
        self.db.execute(
            """
            UPDATE Users
            SET LastLoginDate = ?
            WHERE UserID = ?
            """,
            (
                datetime.now(),
                user_id
            )
        )

        # Записываем успешную попытку
        self.log_attempt(login, True)

        name = full_name or login

        header("УСПЕШНЫЙ ВХОД")

        print()
        print("  ✓ Авторизация выполнена успешно.")
        print()
        print("  Добро пожаловать,", name + "!")

    # ========================================================
    # ЗАПИСЬ ПОПЫТКИ ВХОДА
    # ========================================================

    def log_attempt(self, login, success):
        """Записывает результат входа в базу."""

        self.db.execute(
            """
            INSERT INTO LoginAttempts
                (Login, Success, IPAddress)
            VALUES
                (?, ?, ?)
            """,
            (
                login,
                1 if success else 0,
                "localhost"
            )
        )


