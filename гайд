
import sys
import subprocess

print("Python:", sys.executable)
print("Устанавливаю зависимости...")

result = subprocess.run(
    [
        sys.executable,
        "-m",
        "pip",
        "install",
        "Pillow"
    ],
    capture_output=True,
    text=True
)

print(result.stdout)
print(result.stderr)

if result.returncode == 0:
    print("Pillow установлен.")
else:
    print("Установка не удалась. Скопируй сообщение об ошибке.")
