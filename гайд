class Database:

    def __init__(self):
        self.connection = None
        self.cursor = None

    def connect(self):
        """Подключение к SQL Server."""

        header("СИСТЕМА АВТОРИЗАЦИИ")

        print(f"  Сервер:   {SERVER}")
        print(f"  База:     {DATABASE}")
        print()

        # Определяем доступный драйвер
        drivers = pyodbc.drivers()

        preferred = [
            "ODBC Driver 18 for SQL Server",
            "ODBC Driver 17 for SQL Server",
            "ODBC Driver 13 for SQL Server",
            "SQL Server Native Client 11.0",
            "SQL Server"
        ]

        driver = None

        for item in preferred:
            if item in drivers:
                driver = item
                break

        if driver is None:
            message("✗ Драйвер SQL Server не найден.")
            return False

        connection_string = (
            f"DRIVER={{{driver}}};"
            f"SERVER={SERVER};"
            f"DATABASE={DATABASE};"
            f"UID={USERNAME};"
            f"PWD={PASSWORD};"
            "TrustServerCertificate=yes;"
        )

        try:
            self.connection = pyodbc.connect(
                connection_string,
                timeout=5
            )

            self.cursor = self.connection.cursor()

            message("✓ Подключение к базе данных установлено.")

            return True

        except pyodbc.Error as error:
            message("✗ Ошибка подключения к базе данных.")
            print()
            print(error)

            return False

    def close(self):
        """Закрытие соединения."""

        if self.cursor:
            try:
                self.cursor.close()
            except pyodbc.Error:
                pass

        if self.connection:
            try:
                self.connection.close()
            except pyodbc.Error:
                pass

    def select(self, query, params=()):
        """Выполнение SELECT-запроса."""

        try:
            self.cursor.execute(query, params)
            return self.cursor.fetchone()

        except pyodbc.Error as error:
            message("✗ Ошибка выполнения SQL-запроса.")
            print(error)
            return None

    def execute(self, query, params=()):
        """Выполнение INSERT или UPDATE."""

        try:
            self.cursor.execute(query, params)
            self.connection.commit()
            return True

        except pyodbc.Error as error:
            self.connection.rollback()

            message("✗ Ошибка выполнения SQL-запроса.")
            print(error)

            return False


