from flask import Flask, render_template, jsonify, session, request
import random

app = Flask(__name__)
# В продакшене замените на случайную строку!
app.secret_key = "casino-simulator-secret-key-change-me"

START_BALANCE = 1000

# Символы слотов: (символ, вес, множитель за 3 в ряд)
SLOT_SYMBOLS = ["🍒", "🍋", "🍊", "🔔", "⭐", "💎"]
SLOT_WEIGHTS = [30, 25, 20, 12, 8, 5]
SLOT_PAYOUTS = {"🍒": 5, "🍋": 8, "🍊": 10, "🔔": 15, "⭐": 25, "💎": 50}

RED_NUMBERS = {1, 3, 5, 7, 9, 12, 14, 16, 18,
               19, 21, 23, 25, 27, 30, 32, 34, 36}


def get_balance():
    if "balance" not in session:
        session["balance"] = START_BALANCE
    return session["balance"]


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/balance")
def api_balance():
    return jsonify(balance=get_balance())


@app.route("/api/reset", methods=["POST"])
def api_reset():
    session["balance"] = START_BALANCE
    return jsonify(balance=START_BALANCE)


@app.route("/api/spin", methods=["POST"])
def api_spin():
    data = request.get_json(silent=True) or {}
    try:
        bet = int(data.get("bet", 0))
    except (TypeError, ValueError):
        return jsonify(error="Некорректная ставка"), 400

    balance = get_balance()
    if bet <= 0:
        return jsonify(error="Ставка должна быть больше нуля"), 400
    if bet > balance:
        return jsonify(error="Недостаточно фишек"), 400

    balance -= bet
    reels = random.choices(SLOT_SYMBOLS, weights=SLOT_WEIGHTS, k=3)

    multiplier = 0
    if reels[0] == reels[1] == reels[2]:
        multiplier = SLOT_PAYOUTS[reels[0]]

    winnings = bet * multiplier
    balance += winnings
    session["balance"] = balance

    if multiplier > 0:
        message = f"Выигрыш {winnings} 🪙 (×{multiplier})!"
    else:
        message = "Повезёт в следующий раз!"

    return jsonify(
        reels=reels,
        multiplier=multiplier,
        winnings=winnings,
        balance=balance,
        message=message,
    )


@app.route("/api/roulette", methods=["POST"])
def api_roulette():
    data = request.get_json(silent=True) or {}
    try:
        bet = int(data.get("bet", 0))
    except (TypeError, ValueError):
        return jsonify(error="Некорректная ставка"), 400

    bet_type = data.get("type")
    bet_value = data.get("value")

    balance = get_balance()
    if bet <= 0:
        return jsonify(error="Ставка должна быть больше нуля"), 400
    if bet > balance:
        return jsonify(error="Недостаточно фишек"), 400
    if bet_type not in {"red", "black", "even", "odd", "number"}:
        return jsonify(error="Некорректный тип ставки"), 400

    if bet_type == "number":
        try:
            bet_value = int(bet_value)
        except (TypeError, ValueError):
            return jsonify(error="Введите число от 0 до 36"), 400
        if not 0 <= bet_value <= 36:
            return jsonify(error="Число должно быть от 0 до 36"), 400

    balance -= bet
    number = random.randint(0, 36)

    if number == 0:
        color = "green"
    elif number in RED_NUMBERS:
        color = "red"
    else:
        color = "black"

    win = False
    multiplier = 0
    if bet_type == "red" and color == "red":
        win, multiplier = True, 2
    elif bet_type == "black" and color == "black":
        win, multiplier = True, 2
    elif bet_type == "even" and number != 0 and number % 2 == 0:
        win, multiplier = True, 2
    elif bet_type == "odd" and number % 2 == 1:
        win, multiplier = True, 2
    elif bet_type == "number" and number == bet_value:
        win, multiplier = True, 36

    winnings = bet * multiplier if win else 0
    balance += winnings
    session["balance"] = balance

    return jsonify(
        number=number,
        color=color,
        win=win,
        winnings=winnings,
        balance=balance,
        message=("Выигрыш +" + str(winnings) + " 🪙") if win else "Не повезло...",
    )


if __name__ == "__main__":
    app.run(debug=True)