    def load_tickets(self):
        for item in self.tree.get_children():
            self.tree.delete(item)

        conn = get_connection()
        cur = conn.cursor()

        query = """
            SELECT t.TicketID, t.Subject, c.CategoryName, p.PriorityName, s.StatusName,
                   a.FullName AS AuthorName, ISNULL(e.FullName, N'Не назначен') AS ExecName,
                   CONVERT(VARCHAR(16), t.CreatedAt, 120) AS CreatedStr
            FROM dbo.SDL_Tickets t
            JOIN dbo.SDL_Categories c ON t.CategoryID = c.CategoryID
            JOIN dbo.SDL_Priorities p ON t.PriorityID = p.PriorityID
            JOIN dbo.SDL_Statuses s ON t.StatusID = s.StatusID
            JOIN dbo.SDL_Users a ON t.AuthorID = a.UserID
            LEFT JOIN dbo.SDL_Users e ON t.ExecutorID = e.UserID
            WHERE 1=1
        """
        params = []
        # Сотрудник видит только свои заявки, Исполнитель и Администратор — все
        if self.current_user["role"] == "Сотрудник":
            query += " AND t.AuthorID = ?"
            params.append(self.current_user["id"])

        st_val = self.status_filter.get()
        if st_val != "Все":
            query += " AND s.StatusName = ?"
            params.append(st_val)

        query += " ORDER BY t.TicketID DESC"
        cur.execute(query, params)
        for r in cur.fetchall():
            self.tree.insert("", "end", values=(
                f"#{r.TicketID}", r.Subject, r.CategoryName, r.PriorityName,
                r.StatusName, r.AuthorName, r.ExecName, r.CreatedStr
            ))
        cur.close()
        conn.close()

