* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --gold: #ffd93b;
  --gold-2: #f5a623;
  --bg-1: #0b1029;
  --panel: rgba(22, 28, 68, 0.75);
  --border: rgba(255, 217, 59, 0.25);
  --text: #eef1ff;
  --muted: #9aa3c7;
  --green: #4ade80;
  --red: #f87171;
  --shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
}

html, body { height: 100%; }

body {
  font-family: "Segoe UI", Roboto, system-ui, sans-serif;
  background: radial-gradient(circle at 15% 10%, #232a63, var(--bg-1) 55%), var(--bg-1);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

.background-glow {
  position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background:
    radial-gradient(circle at 80% 20%, rgba(255, 217, 59, 0.10), transparent 40%),
    radial-gradient(circle at 10% 80%, rgba(120, 90, 255, 0.12), transparent 45%);
}

/* ---------- Верхняя панель ---------- */
.topbar {
  position: relative; z-index: 2;
  display: flex; align-items: center; justify-content: space-between;
  gap: 16px; padding: 16px 28px;
  background: rgba(10, 14, 40, 0.7);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.logo { font-size: 1.4rem; font-weight: 800; letter-spacing: 0.5px; }
.logo span { color: var(--gold); }

.balance-box {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 18px;
  background: linear-gradient(135deg, rgba(255, 217, 59, 0.12), rgba(245, 166, 35, 0.12));
  border: 1px solid var(--border);
  border-radius: 999px;
  box-shadow: 0 0 20px rgba(255, 217, 59, 0.12);
}
.balance-label { color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; }
.balance-value { font-weight: 800; font-size: 1.2rem; color: var(--gold); transition: transform 0.1s; }
.balance-value.pop { animation: pop 0.35s ease; }
@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.35); color: #fff; }
  100% { transform: scale(1); }
}
.chip-icon { font-size: 1.1rem; }

/* ---------- Кнопки ---------- */
.btn {
  border: none; cursor: pointer; border-radius: 12px;
  padding: 10px 18px; font-weight: 700; font-size: 0.95rem;
  transition: transform 0.15s, box-shadow 0.15s, background 0.2s, color 0.2s;
}
.btn:disabled { opacity: 0.5; cursor: not-allowed; }
.btn.ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
.btn.ghost:hover { color: var(--gold); border-color: var(--gold); }
.btn.primary {
  background: linear-gradient(135deg, var(--gold), var(--gold-2));
  color: #1a1400; padding: 14px 36px; font-size: 1.05rem;
  letter-spacing: 0.5px;
  box-shadow: 0 6px 24px rgba(255, 217, 59, 0.3);
}
.btn.primary:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(255, 217, 59, 0.45);
}
.btn.primary:active:not(:disabled) { transform: translateY(0); }

/* ---------- Контейнер ---------- */
.container {
  position: relative; z-index: 2;
  width: min(980px, 94vw);
  margin: 24px auto; flex: 1;
}

.notice {
  display: flex; gap: 12px; align-items: flex-start;
  padding: 14px 18px; margin-bottom: 20px;
  background: rgba(77, 171, 247, 0.08);
  border: 1px solid rgba(77, 171, 247, 0.3);
  border-radius: 14px;
  color: #bcd7ff; font-size: 0.9rem; line-height: 1.5;
}
.notice strong { color: #e3efff; }

/* ---------- Табы ---------- */
.tabs { display: flex; gap: 10px; margin-bottom: 20px; }
.tab {
  flex: 1; padding: 14px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 14px;
  color: var(--muted);
  font-size: 1.05rem; font-weight: 700;
  cursor: pointer; transition: all 0.2s;
}
.tab:hover { color: var(--text); }
.tab.active {
  color: #1a1400;
  background: linear-gradient(135deg, var(--gold), var(--gold-2));
  border-color: transparent;
  box-shadow: 0 6px 24px rgba(255, 217, 59, 0.3);
}

.panel { display: none; }
.panel.active { display: block; animation: fade 0.3s ease; }
@keyframes fade {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: none; }
}

/* ---------- Слоты ---------- */
.machine {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 34px 24px 24px;
  box-shadow: var(--shadow);
  text-align: center;
  backdrop-filter: blur(12px);
}
.reels {
  display: flex; justify-content: center;
  gap: 16px; margin-bottom: 18px;
}
.reel {
  width: 110px; height: 130px;
  display: flex; align-items: center; justify-content: center;
  font-size: 3.6rem;
  background: linear-gradient(180deg, #fffdf3, #ffe9a8);
  border: 3px solid var(--gold);
  border-radius: 16px;
  box-shadow: inset 0 4px 12px rgba(0,0,0,0.15),
              0 8px 24px rgba(255, 217, 59, 0.25);
  transition: transform 0.15s;
  user-select: none;
}
.reel.spinning { animation: shake 0.12s infinite; }
@keyframes shake {
  0%   { transform: translateY(-3px); }
  50%  { transform: translateY(3px); }
  100% { transform: translateY(-3px); }
}
.reel.win { animation: winPulse 0.45s ease 2; }
@keyframes winPulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.15); box-shadow: 0 0 40px rgba(255, 217, 59, 0.9); }
}

.message {
  min-height: 28px; font-size: 1.05rem; font-weight: 600;
  color: var(--muted); transition: color 0.2s;
}
.message.win  { color: var(--green); text-shadow: 0 0 16px rgba(74, 222, 128, 0.5); }
.message.lose { color: var(--red); }

/* ---------- Контролы ---------- */
.controls {
  margin-top: 20px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 22px;
  display: flex; flex-direction: column;
  align-items: center; gap: 16px;
  backdrop-filter: blur(12px);
}
.chips { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
.chip {
  width: 62px; height: 62px;
  border-radius: 50%;
  border: 2px dashed rgba(255,255,255,0.4);
  background: radial-gradient(circle at 30% 30%, #ff6b6b, #c0392b);
  color: white; font-weight: 800; font-size: 0.95rem;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s;
  box-shadow: 0 6px 16px rgba(0,0,0,0.35);
}
.chip:nth-child(2) { background: radial-gradient(circle at 30% 30%, #4dabf7, #1864ab); }
.chip:nth-child(3) { background: radial-gradient(circle at 30% 30%, #51cf66, #2b8a3e); }
.chip:nth-child(4) { background: radial-gradient(circle at 30% 30%, #cc5de8, #862e9c); }
.chip:hover { transform: translateY(-3px) scale(1.05); }
.chip.active {
  border-color: var(--gold);
  box-shadow: 0 0 0 3px var(--gold), 0 6px 20px rgba(255, 217, 59, 0.4);
}
.bet-display { color: var(--muted); font-size: 1.05rem; }
.bet-display span { color: var(--gold); font-weight: 800; font-size: 1.2rem; }

/* ---------- Таблица выплат ---------- */
.paytable {
  margin-top: 20px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 22px;
  backdrop-filter: blur(12px);
}
.paytable h3 { color: var(--gold); margin-bottom: 14px; text-align: center; letter-spacing: 1px; }
.paytable-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.paytable-grid > div {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  padding: 12px; text-align: center; font-weight: 600;
}
.paytable-grid span { font-size: 1.2rem; margin-right: 6px; }

/* ---------- Рулетка ---------- */
.roulette-wrap {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 30px 20px;
  box-shadow: var(--shadow);
  text-align: center;
  backdrop-filter: blur(12px);
}
.wheel-result {
  width: 140px; height: 140px;
  border-radius: 50%;
  margin: 0 auto 18px;
  display: flex; align-items: center; justify-content: center;
  font-size: 3rem; font-weight: 900;
  color: #fff;
  background: rgba(0,0,0,0.4);
  border: 4px solid var(--muted);
  text-shadow: 0 2px 8px rgba(0,0,0,0.6);
  transition: background 0.3s, border-color 0.3s;
  box-shadow: 0 0 24px rgba(0,0,0,0.4);
}
.wheel-result.red {
  background: radial-gradient(circle at 30% 30%, #ff6b6b, #b02a2a);
  border-color: #ff6b6b;
}
.wheel-result.black {
  background: radial-gradient(circle at 30% 30%, #4a4a5a, #14141c);
  border-color: #888;
}
.wheel-result.green {
  background: radial-gradient(circle at 30% 30%, #4ade80, #15803d);
  border-color: #4ade80;
}
.wheel-result.spinning { animation: wheelShake 0.12s infinite; }
@keyframes wheelShake {
  0%   { transform: rotate(-3deg); }
  50%  { transform: rotate(3deg); }
  100% { transform: rotate(-3deg); }
}

.bets { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
.bet-btn {
  padding: 12px 18px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.04);
  color: var(--text); font-weight: 600;
  cursor: pointer; transition: all 0.15s;
}
.bet-btn:hover { border-color: var(--gold); }
.bet-btn.active {
  background: linear-gradient(135deg, rgba(255,217,59,0.2), rgba(245,166,35,0.2));
  border-color: var(--gold);
  color: var(--gold);
}
.number-bet { display: flex; gap: 10px; align-items: center; }
.number-bet input {
  width: 110px; padding: 12px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: rgba(0,0,0,0.3);
  color: var(--text); font-size: 1rem;
  text-align: center; outline: none;
}
.number-bet input:focus { border-color: var(--gold); }

/* ---------- Футер ---------- */
.footer {
  position: relative; z-index: 2;
  text-align: center;
  padding: 20px;
  color: var(--muted);
  font-size: 0.85rem;
  border-top: 1px solid rgba(255,255,255,0.06);
  background: rgba(10, 14, 40, 0.5);
}
.footer p { margin: 4px 0; }
.footer strong { color: var(--gold); }

/* ---------- Адаптив ---------- */
@media (max-width: 640px) {
  .reel { width: 84px; height: 104px; font-size: 2.6rem; }
  .topbar { padding: 12px 16px; flex-wrap: wrap; }
  .balance-box { padding: 6px 14px; }
  .logo { font-size: 1.1rem; }
  .paytable-grid { grid-template-columns: repeat(2, 1fr); }
  .wheel-result { width: 110px; height: 110px; font-size: 2.4rem; }
}