class Database:
    """Класс для работы с базой данных Ip_23_01"""
    
    def __init__(self):
        self.connection = None
        self.cursor = None
    
    def connect(self):
        """Подключение к базе данных"""
        print(f"\nПодключение к базе данных {DATABASE}...")
        print(f"Сервер: {SERVER}")
        print(f"Пользователь: {USERNAME}")
        
        # Список драйверов для перебора
        drivers = [
            '{ODBC Driver 17 for SQL Server}',
            '{ODBC Driver 13 for SQL Server}',
            '{SQL Server}',
            '{SQL Server Native Client 11.0}'
        ]
        
        for driver in drivers:
            try:
                connection_string = (
                    f"DRIVER={driver};"
                    f"SERVER={SERVER};"
                    f"DATABASE={DATABASE};"
                    f"UID={USERNAME};"
                    f"PWD={PASSWORD}"
                )
                
                self.connection = pyodbc.connect(connection_string)
                self.cursor = self.connection.cursor()
                print(f"✓ Подключение успешно (драйвер: {driver})\n")
                return True
                
            except pyodbc.Error as e:
                # Пробуем следующий драйвер
                continue
        
        print("✗ Не удалось подключиться к базе данных")
        print("\nПроверьте:")
        print(f"1. Доступен ли сервер: {SERVER}")
        print(f"2. Правильный ли логин: {USERNAME}")
        print("3. Правильный ли пароль")
        print(f"4. Существует ли база данных: {DATABASE}")
        return False
    
    def disconnect(self):
        """Закрытие соединения"""
        if self.connection:
            self.connection.close()
            print("✓ Соединение закрыто")
    
    def execute(self, query, params=None):
        """Выполнение SQL-запроса"""
        try:
            if params:
                self.cursor.execute(query, params)
            else:
                self.cursor.execute(query)
            
            # Проверяем, есть ли результаты
            if self.cursor.description:
                result = self.cursor.fetchall()
                self.connection.commit()
                return result
            else:
                self.connection.commit()
                return True
                
        except pyodbc.Error as e:
            print(f"✗ Ошибка SQL: {e}")
            try:
                self.connection.rollback()
            except:
                pass
            return None

class AuthSystem:
    """Система авторизации"""
    
    def __init__(self, db):
        self.db = db
    
    def hash_password(self, password, salt=None):
        """Хеширование пароля с солью"""
        if salt is None:
            salt = secrets.token_hex(16)
        
        password_salt = password + salt
        password_hash = hashlib.sha256(password_salt.encode()).hexdigest()
        
        return password_hash, salt
    
    def register(self):
        """Регистрация нового пользователя"""
        print("\n" + "="*50)
        print("РЕГИСТРАЦИЯ НОВОГО ПОЛЬЗОВАТЕЛЯ")
        print("="*50)
        
        # Ввод логина
        while True:
            login = input("Придумайте логин: ").strip()
            if not login:
                print("✗ Логин не может быть пустым\n")
                continue
            break
        
        # Проверка существования логина
        result = self.db.execute(
            "SELECT UserID FROM Users WHERE Login = ?",
            (login,)
        )
        if result:
            print(f"✗ Пользователь с логином '{login}' уже существует\n")
            return
        
        # Ввод пароля
        while True:
            password = input("Придумайте пароль (мин. 4 символа): ")
            if len(password) < 4:
                print("✗ Пароль слишком короткий\n")
                continue
            break
        
        # Дополнительные данные
        full_name = input("Введите полное имя (Enter - пропустить): ").strip()
        email = input("Введите email (Enter - пропустить): ").strip()
        
        # Хеширование пароля
        password_hash, salt = self.hash_password(password)
        
        # Сохранение в базу данных
        result = self.db.execute(
            """INSERT INTO Users (Login, PasswordHash, Salt, FullName, Email) 
               VALUES (?, ?, ?, ?, ?)""",
            (login, password_hash, salt, full_name or None, email or None)
        )
        
        if result:
            print("\n✓ Регистрация успешна!")
            print(f"  Логин: {login}")
            if full_name:
                print(f"  Имя: {full_name}")
        else:
            print("\n✗ Ошибка при регистрации")
    
    def login(self):
        """Вход пользователя в систему"""
        print("\n" + "="*50)
        print("ВХОД В СИСТЕМУ")
        print("="*50)
        
        login = input("Введите логин: ").strip()
        password = input("Введите пароль: ")
        
        # Поиск пользователя
        result = self.db.execute(
            """SELECT UserID, PasswordHash, Salt, FullName, IsActive 
               FROM Users WHERE Login = ?""",
            (login,)
        )
        
        if not result:
            # Логирование неудачной попытки
            self.db.execute(
                "INSERT INTO LoginAttempts (Login, Success, IPAddress) VALUES (?, 0, 'localhost')",
                (login,)
            )
            print("\n✗ Неверный логин или пароль")
            return False
        
        user_id, stored_hash, salt, full_name, is_active = result[0]
        
        # Проверка активности
        if not is_active:
            print("\n✗ Аккаунт заблокирован")
            return False
        
        # Проверка пароля
        entered_hash, _ = self.hash_password(password, salt)
        
        if entered_hash == stored_hash:
            # Обновление времени последнего входа
            self.db.execute(
                "UPDATE Users SET LastLoginDate = ? WHERE UserID = ?",
                (datetime.datetime.now(), user_id)
            )
            # Логирование успешной попытки
            self.db.execute(
                "INSERT INTO LoginAttempts (Login, Success, IPAddress) VALUES (?, 1, 'localhost')",
                (login,)
            )
            display_name = full_name or login
            print(f"\n✓ Авторизация успешна!")
            print(f"  Добро пожаловать, {display_name}!")
            return True
        else:
            # Логирование неудачной попытки
            self.db.execute(
                "INSERT INTO LoginAttempts (Login, Success, IPAddress) VALUES (?, 0, 'localhost')",
                (login,)
            )
            print("\n✗ Неверный логин или пароль")
            return False
    
    def change_password(self):
        """Смена пароля"""
        print("\n" + "="*50)
        print("СМЕНА ПАРОЛЯ")
        print("="*50)
        
        login = input("Введите логин: ").strip()
        old_password = input("Введите старый пароль: ")
        
        # Проверка старого пароля
        result = self.db.execute(
            "SELECT PasswordHash, Salt FROM Users WHERE Login = ?",
            (login,)
        )
        
        if not result:
            print("\n✗ Пользователь не найден")
            return False
        
        stored_hash, salt = result[0]
        old_hash, _ = self.hash_password(old_password, salt)
        
        if old_hash != stored_hash:
            print("\n✗ Старый пароль неверен")
            return False
        
        # Ввод нового пароля
        while True:
            new_password = input("Введите новый пароль (мин. 4 символа): ")
            if len(new_password) < 4:
                print("✗ Пароль слишком короткий")
                continue
            break
        
        # Обновление пароля
        new_hash, new_salt = self.hash_password(new_password)
        result = self.db.execute(
            "UPDATE Users SET PasswordHash = ?, Salt = ? WHERE Login = ?",
            (new_hash, new_salt, login)
        )
        
        if result:
            print("\n✓ Пароль успешно изменён")
            return True
        return False
    
    def show_users(self):
        """Показать список пользователей"""
        print("\n" + "="*50)
        print("СПИСОК ПОЛЬЗОВАТЕЛЕЙ")
        print("="*50)
        
        result = self.db.execute(
            """SELECT Login, FullName, Email, CreatedDate, LastLoginDate, IsActive 
               FROM Users ORDER BY CreatedDate DESC"""
        )
        
        if result:
            print(f"\n{'Логин':<15} {'Имя':<20} {'Email':<25} {'Создан':<20} {'Активен':<10}")
            print("-"*90)
            for user in result:
                login, full_name, email, created, last_login, is_active = user
                active = "Да" if is_active else "Нет"
                print(f"{login:<15} {(full_name or 'N/A'):<20} {(email or 'N/A'):<25} {str(created):<20} {active:<10}")
            print(f"\nВсего пользователей: {len(result)}")
        else:
            print("✗ Нет зарегистрированных пользователей")
    
    def show_login_attempts(self):
        """Показать историю попыток входа"""
        print("\n" + "="*50)
        print("ИСТОРИЯ ПОПЫТОК ВХОДА")
        print("="*50)
        
        result = self.db.execute(
            """SELECT TOP 20 Login, AttemptDate, Success, IPAddress 
               FROM LoginAttempts ORDER BY AttemptDate DESC"""
        )
        
        if result:
            print(f"\n{'Логин':<15} {'Дата':<25} {'Успех':<10} {'IP адрес':<15}")
            print("-"*65)
            for attempt in result:
                login, attempt_date, success, ip = attempt
                success_str = "Да" if success else "Нет"
                print(f"{login:<15} {str(attempt_date):<25} {success_str:<10} {ip:<15}")
        else:
            print("✗ История попыток пуста")

