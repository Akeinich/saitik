PASSWORD = 'Qweasd01'


def connect():
    driver = [d for d in pyodbc.drivers() if 'SQL Server' in d][0]

    return pyodbc.connect(
        f'DRIVER={{{driver}}};'
        f'SERVER={SERVER};'
        f'DATABASE={DATABASE};'
        f'UID={USERNAME};'
        f'PWD={PASSWORD}'
    )


def hash_password(password, salt):
    return hashlib.sha256(
        salt + password.encode()
    ).hexdigest()


def register():
    login = input('Логин: ')
    password = input('Пароль: ')
    name = input('ФИО: ')
    email = input('Email: ')

    db = connect()
    cursor = db.cursor()

    cursor.execute(
        'SELECT UserID FROM Users WHERE Login = ?',
        login
    )

    if cursor.fetchone():
        print('Такой логин уже существует.')
        db.close()
        return

    salt = secrets.token_bytes(16)
    password_hash = hash_password(password, salt)

    cursor.execute(
        '''INSERT INTO Users
        (Login, PasswordHash, Salt, FullName, Email, IsActive)
        VALUES (?, ?, ?, ?, ?, 1)''',
        login, password_hash, salt, name, email
    )

    db.commit()
    db.close()

    print('Регистрация успешна!')


def login():
    login = input('Логин: ')
    password = input('Пароль: ')

    db = connect()
    cursor = db.cursor()

    cursor.execute(
        'SELECT PasswordHash, Salt, FullName FROM Users '
        'WHERE Login = ? AND IsActive = 1',
        login
    )

    user = cursor.fetchone()

    if not user:
        print('Неверный логин или пароль.')
        db.close()
        return

    password_hash = hash_password(password, user.Salt)

    if hmac.compare_digest(password_hash, user.PasswordHash):
        print('Добро пожаловать,', user.FullName)
    else:
        print('Неверный логин или пароль.')

    db.close()


