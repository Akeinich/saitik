    def update_hud(self):
        self.hud.setText(
            f"HEALTH {self.health:03d}    "
            f"AMMO {self.ammo:03d}    "
            f"KILLS {self.kills:02d}    "
            f"SCORE {self.score:04d}"
        )

    # =================================================
    # КОЛЛИЗИИ С КАРТОЙ
    # =================================================

    def is_wall(self, x, y):
        col = int(x // self.cell)
        row = self.map_h - 1 - int(y // self.cell)

        if row < 0 or row >= self.map_h:
            return True

        if col < 0 or col >= self.map_w:
            return True

        return self.level[row][col] == "#"

    def can_move(self, x, y):
        radius = 0.28

        return (
            not self.is_wall(x - radius, y - radius)
            and not self.is_wall(x + radius, y - radius)
            and not self.is_wall(x - radius, y + radius)
            and not self.is_wall(x + radius, y + radius)
        )

    # =================================================
    # УПРАВЛЕНИЕ ИГРОКОМ
    # =================================================

    def update_mouse(self):
        if not self.mouseWatcherNode.hasMouse():
            self.mouse_ready = False
            return

        pointer = self.win.getPointer(0)
        width = self.win.getXSize()
        height = self.win.getYSize()

        if width <= 0 or height <= 0:
            return

        cx = width // 2
        cy = height // 2

        if not self.mouse_ready:
            self.win.movePointer(0, cx, cy)
            self.mouse_ready = True
            return

        dx = pointer.getX() - cx
        dy = pointer.getY() - cy

        self.heading -= dx * self.mouse_sensitivity
        self.pitch = max(
            -65,
            min(65, self.pitch + dy * self.mouse_sensitivity),
        )

        self.camera.setHpr(self.heading, self.pitch, 0)
        self.win.movePointer(0, cx, cy)

    def update_player(self, dt):
        forward = 0
        sideways = 0

        if self.mouseWatcherNode.isButtonDown("w"):
            forward += 1

        if self.mouseWatcherNode.isButtonDown("s"):
            forward -= 1

        if self.mouseWatcherNode.isButtonDown("d"):
            sideways += 1

        if self.mouseWatcherNode.isButtonDown("a"):
            sideways -= 1

        if forward == 0 and sideways == 0:
            return

        length = math.sqrt(
            forward * forward + sideways * sideways
        )

        forward /= length
        sideways /= length

        angle = math.radians(self.heading)

        dx = (
            -math.sin(angle) * forward
            + math.cos(angle) * sideways
        ) * self.player_speed * dt

        dy = (
            math.cos(angle) * forward
            + math.sin(angle) * sideways
        ) * self.player_speed * dt

        new_x = self.player_x + dx
        new_y = self.player_y + dy

        # Раздельное движение позволяет скользить вдоль стен.
        if self.can_move(new_x, self.player_y):
            self.player_x = new_x

        if self.can_move(self.player_x, new_y):
            self.player_y = new_y

        self.camera.setPos(
            self.player_x,
            self.player_y,
            1.55,
        )

    # =================================================
    # ВРАГИ
    # =================================================

    def spawn_enemies(self, count):
        for _ in range(count):
            for attempt in range(100):
                x = random.uniform(
                    self.cell,
                    (self.map_w - 1) * self.cell,
                )
                y = random.uniform(
                    self.cell,
                    (self.map_h - 1) * self.cell,
                )

                distance = math.hypot(
                    x - self.player_x,
                    y - self.player_y,
                )

                if self.is_wall(x, y) or distance < 10:
                    continue

                enemy = self.loader.loadModel("models/smiley")
                enemy.setScale(0.85)
                enemy.setColor(0.85, 0.08, 0.05, 1)
                enemy.setPos(x, y, 1.1)
                enemy.reparentTo(self.render)

                self.enemies.append({
                    "node": enemy,
                    "hp": 2,
                    "attack": random.uniform(0.0, 0.5),
                })
                break

    def update_enemies(self, dt):
        for enemy in self.enemies[:]:
            node = enemy["node"]

            x = node.getX()
            y = node.getY()

            dx = self.player_x - x
            dy = self.player_y - y
            distance = math.hypot(dx, dy)

            if distance > 1.2:
                speed = 1.5

                move_x = dx / max(distance, 0.001) * speed * dt
                move_y = dy / max(distance, 0.001) * speed * dt

                if self.can_move(x + move_x, y):
                    node.setX(x + move_x)

                if self.can_move(node.getX(), y + move_y):
                    node.setY(y + move_y)

            # Поворачиваем лицо врага к игроку.
            node.lookAt(
                self.camera.getPos(self.render)
            )

            enemy["attack"] -= dt

            if distance < 1.5 and enemy["attack"] <= 0:
                self.health -= 10
                enemy["attack"] = 1.0
                self.update_hud()

                if self.health <= 0:
                    self.health = 0
                    self.end_game()

    # =================================================
    # СТРЕЛЬБА
    # =================================================

    def shoot(self):
        if self.game_over or self.shoot_cooldown > 0:
            return

        if self.ammo <= 0:
            self.message.setText("OUT OF AMMO")
            return

        self.ammo -= 1
        self.shoot_cooldown = 0.25

        # Проверяем направление взгляда и ближайшего видимого врага.
        angle = math.radians(self.heading)
        dir_x = -math.sin(angle)
        dir_y = math.cos(angle)

        best_enemy = None
        best_distance = 999999

        for enemy in self.enemies:
            node = enemy["node"]

            dx = node.getX() - self.player_x
            dy = node.getY() - self.player_y
            distance = math.hypot(dx, dy)

            if distance > 30 or distance < 0.1:
                continue

            dot = (
                dx / distance * dir_x
                + dy / distance * dir_y
            )

            # Чем меньше число, тем точнее надо прицелиться.
            if dot < 0.985:
                continue

            # Не стреляем сквозь стены.
            steps = max(1, int(distance / 0.2))
            blocked = False

            for i in range(1, steps):
                t = i / steps

                check_x = self.player_x + dx * t
                check_y = self.player_y + dy * t

                if self.is_wall(check_x, check_y):
                    blocked = True
                    break

            if blocked:
                continue

            if distance < best_distance:
                best_distance = distance
                best_enemy = enemy

        if best_enemy is not None:
            best_enemy["hp"] -= 1
            self.message.setText("HIT!")

            if best_enemy["hp"] <= 0:
                best_enemy["node"].removeNode()
                self.enemies.remove(best_enemy)

                self.score += 100
                self.kills += 1

                if len(self.enemies) == 0:
                    self.spawn_enemies(5)
        else:
            self.message.setText("")

        self.update_hud()

    # =================================================
    # ИГРОВОЙ ЦИКЛ
    # =================================================

    def update(self, task):
        dt = min(
            ClockObject.getGlobalClock().getDt(),
            0.05,
        )

        if self.game_over:
            return task.cont

        self.shoot_cooldown = max(
            0,
            self.shoot_cooldown - dt,
        )

        self.damage_cooldown = max(
            0,
            self.damage_cooldown - dt,
        )

        self.update_mouse()
        self.update_player(dt)
        self.update_enemies(dt)

        return task.cont

    # =================================================
    # ЗАВЕРШЕНИЕ И ПЕРЕЗАПУСК
    # =================================================

    def end_game(self):
        self.game_over = True
        self.message.setText(
            "YOU DIED\n\n"
            f"SCORE: {self.score}\n"
            f"KILLS: {self.kills}\n\n"
            "PRESS R TO RESTART"
        )

    def restart(self):
        for enemy in self.enemies:
            enemy["node"].removeNode()

        self.enemies.clear()

        self.health = 100
        self.ammo = 50
        self.score = 0
        self.kills = 0

        self.game_over = False
        self.shoot_cooldown = 0
        self.message.setText("")

        self.player_x = 6 * self.cell + 2
        self.player_y = 9 * self.cell + 2

        self.heading = 180
        self.pitch = 0
        self.mouse_ready = False

        self.camera.setPos(
            self.player_x,
            self.player_y,
            1.55,
        )
        self.camera.setHpr(self.heading, self.pitch, 0)

        self.spawn_enemies(5)
        self.update_hud()


game = RetroDoom()
game.run()
