    def handle_login(self):
        email = self.email_entry.get().strip()
        pwd = self.pass_entry.get().strip()
        if not email or not pwd:
            messagebox.showwarning("Ошибка ввода", "Заполните логин и пароль!")
            return

        try:
            conn = get_connection()
            cur = conn.cursor()
            cur.execute(
                """
                SELECT u.UserID, u.FullName, u.Email, r.RoleName, u.IsActive
                FROM dbo.SDL_Users u
                JOIN dbo.SDL_Roles r ON u.RoleID = r.RoleID
                WHERE u.Email = ? AND u.PasswordHash = ?
                """,
                (email, hash_password(pwd)),
            )
            row = cur.fetchone()
            cur.close()
            conn.close()

            if not row:
                messagebox.showerror("Ошибка авторизации", "Неверный логин или пароль.")
                return
            if not row.IsActive:
                messagebox.showerror("Доступ запрещён", "Учётная запись заблокирована администратором.")
                return

            self.current_user = {
                "id": row.UserID,
                "name": row.FullName,
                "email": row.Email,
                "role": row.RoleName,
            }
            self.show_main_screen()
        except Exception as e:
            messagebox.showerror("Ошибка БД", f"Не удалось подключиться к SQL Server:\n{e}")

