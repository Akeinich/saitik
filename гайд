class RetroDoom(ShowBase):
    def __init__(self):
        self.enemies = []
        self.game_over = False
        super().__init__()

        self.disableMouse()
        self.setBackgroundColor(0.025, 0.02, 0.035, 1)

        # ---------------- НАСТРОЙКИ ----------------

        self.cell = 4
        self.player_speed = 6.0
        self.mouse_sensitivity = 0.12

        self.health = 100
        self.ammo = 50
        self.score = 0
        self.kills = 0

        self.heading = 0.0
        self.pitch = 0.0
        self.mouse_ready = False

        self.game_over = False
        self.shoot_cooldown = 0.0
        self.damage_cooldown = 0.0
        self.spawn_timer = 0.0

        self.enemies = []

        # # = стена, . = пол
        self.level = [
            "############",
            "#..........#",
            "#..##......#",
            "#..##..##..#",
            "#......##..#",
            "#.##.......#",
            "#.##..###..#",
            "#..........#",
            "#..###.....#",
            "#......##..#",
            "#..........#",
            "############",
        ]

        self.map_h = len(self.level)
        self.map_w = len(self.level[0])

        self.player_x = 6 * self.cell + 2
        self.player_y = 9 * self.cell + 2

        # ---------------- МЫШЬ ----------------

        props = WindowProperties()
        props.setCursorHidden(True)
        props.setMouseMode(WindowProperties.M_absolute)
        self.win.requestProperties(props)

        self.camera.setPos(
            self.player_x,
            self.player_y,
            1.55,
        )
        self.camera.setHpr(180, 0, 0)

        # ---------------- ОСВЕЩЕНИЕ ----------------

        ambient = AmbientLight("ambient")
        ambient.setColor(Vec4(0.65, 0.58, 0.55, 1))
        ambient_np = self.render.attachNewNode(ambient)
        self.render.setLight(ambient_np)

        sun = DirectionalLight("sun")
        sun.setColor(Vec4(0.45, 0.42, 0.4, 1))
        sun_np = self.render.attachNewNode(sun)
        sun_np.setHpr(-30, -60, 0)
        self.render.setLight(sun_np)

        # ---------------- МИР ----------------

        self.build_level()

        # ---------------- ИНТЕРФЕЙС ----------------

        self.create_ui()

        # ---------------- СОБЫТИЯ ----------------

        self.accept("escape", self.userExit)
        self.accept("mouse1", self.shoot)
        self.accept("r", self.restart)
        self.accept("enter", self.restart)

        self.taskMgr.add(self.update, "game_update")

        self.spawn_enemies(5)

    # =================================================
    # СОЗДАНИЕ КАРТЫ
    # =================================================

    def make_card(self, name, x1, x2, z1, z2, color,
                  x, y, z, heading=0, pitch=0):
        maker = CardMaker(name)
        maker.setFrame(x1, x2, z1, z2)

        node = self.render.attachNewNode(maker.generate())
        node.setPos(x, y, z)
        node.setHpr(heading, pitch, 0)
        node.setColor(*color)
        node.setTwoSided(True)

        return node

    def build_level(self):
        # Пол
        floor = self.make_card(
            "floor",
            -2, self.map_w * self.cell,
            -2, self.map_h * self.cell,
            (0.19, 0.16, 0.15, 1),
            0, 0, 0,
        )

        # Потолок
        ceiling = self.make_card(
            "ceiling",
            -2, self.map_w * self.cell,
            -2, self.map_h * self.cell,
            (0.10, 0.09, 0.11, 1),
            0, 0, 3.5,
            pitch=180,
        )

        # Стены. Каждая стена — простая плоскость.
        for row, line in enumerate(self.level):
            for col, char in enumerate(line):
                if char != "#":
                    continue

                x = col * self.cell + self.cell / 2
                y = (self.map_h - 1 - row) * self.cell + self.cell / 2

                color = random.choice([
                    (0.34, 0.12, 0.10, 1),
                    (0.28, 0.10, 0.09, 1),
                    (0.38, 0.16, 0.12, 1),
                ])

                # Четыре стороны стены.
                self.make_card(
                    "wall_front",
                    -self.cell / 2, self.cell / 2,
                    0, 3.5,
                    color,
                    x, y - self.cell / 2, 0,
                    pitch=90,
                )

                self.make_card(
                    "wall_back",
                    -self.cell / 2, self.cell / 2,
                    0, 3.5,
                    color,
                    x, y + self.cell / 2, 0,
                    pitch=90,
                )

                self.make_card(
                    "wall_left",
                    -self.cell / 2, self.cell / 2,
                    0, 3.5,
                    color,
                    x - self.cell / 2, y, 0,
                    heading=90,
                    pitch=90,
                )

                self.make_card(
                    "wall_right",
                    -self.cell / 2, self.cell / 2,
                    0, 3.5,
                    color,
                    x + self.cell / 2, y, 0,
                    heading=90,
                    pitch=90,
                )

