
import os
import sys
import traceback

DEPIX_FOLDER = r"D:\ЗАГРУЗКИ\Depix"
INPUT_IMAGE = r"D:\ЗАГРУЗКИ\pixelated.png"
OUTPUT_IMAGE = r"D:\ЗАГРУЗКИ\depix_result.png"

SEARCH_IMAGE = os.path.join(
    DEPIX_FOLDER,
    "images",
    "searchimages",
    "debruinseq_notepad_Windows10_closeAndSpaced.png"
)

try:
    if not os.path.isfile(INPUT_IMAGE):
        raise FileNotFoundError(
            "Не найдена исходная картинка: " + INPUT_IMAGE
        )

    if not os.path.isfile(SEARCH_IMAGE):
        raise FileNotFoundError(
            "Не найдено поисковое изображение: " + SEARCH_IMAGE
        )

    sys.path.insert(0, DEPIX_FOLDER)
    os.chdir(DEPIX_FOLDER)

    import depix

    sys.argv = [
        "depix.py",
        "-p", INPUT_IMAGE,
        "-s", SEARCH_IMAGE,
        "-o", OUTPUT_IMAGE
    ]

    depix.main()

    print("\nРабота завершена.")
    print("Результат:", OUTPUT_IMAGE)

except Exception:
    traceback.print_exc()

input("\nНажми Enter для выхода.")
